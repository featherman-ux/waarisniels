---
import type { Post } from '../lib/db';
import { mediaUrl } from '../lib/media';

export interface Props { post: Post; eager?: boolean }
const { post, eager = false } = Astro.props;
const href = `/blog/${post.slug}/`;
const imgSrc = mediaUrl(post.cover?.key) ?? '/images/homepage.jpeg';
const imgAlt = post.cover?.alt ?? post.title;
---
<article class="rounded-lg border bg-white dark:bg-gray-800 p-4 shadow-sm hover:shadow-md transition">
  <a href={href} class="block">
    <div class="relative mb-3 overflow-hidden rounded-md bg-gray-100 dark:bg-gray-900 aspect-[4/3] md:aspect-[5/3]">
      <img
        src={imgSrc}
        alt={imgAlt}
        class="absolute inset-0 h-full w-full object-cover md:object-contain md:p-2"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
    <h3 class="text-xl font-semibold">{post.title}</h3>
    <p class="text-sm text-gray-500 mb-2">
      {post.pubDate.toLocaleDateString('nl-NL')}
    </p>
    {post.description && (
      <p class="text-gray-700 dark:text-gray-300 line-clamp-3">{post.description}</p>
    )}
    <span class="inline-block mt-3 underline">Lees verder</span>
  </a>
</article>
