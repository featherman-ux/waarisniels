---
import type { Post } from '../lib/db';
import { mediaUrl, mediaSrcSet } from '../lib/media';

export interface Props { post: Post; eager?: boolean }
const { post, eager = false } = Astro.props;
const href = `/blog/${post.slug}/`;
const coverKey = post.cover?.key;
const imgSrc = mediaUrl(coverKey, { width: 960 }) ?? mediaUrl(coverKey) ?? '/images/homepage.jpeg';
const imgSrcSet = coverKey ? mediaSrcSet(coverKey, [480, 960]) : undefined;
const imgAlt = post.cover?.alt ?? post.title;

// Categorielabels uit migrations/0001_init.sql — als er ooit een derde categorie
// bijkomt via de D1 categories-tabel, moet die hier ook een label krijgen.
const CATEGORY_LABELS: Record<string, string> = { reis: 'Reisverhaal', overig: 'Overig' };
const categoryLabel = CATEGORY_LABELS[post.category] ?? post.category;

const wordCount = post.body.trim().split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));
---
<article class="group">
  <a href={href} class="block">
    <div class="relative mb-3 overflow-hidden rounded-sm bg-paper-alt aspect-[4/3] md:aspect-[5/3]">
      <img
        src={imgSrc}
        srcset={imgSrcSet}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        alt={imgAlt}
        class="card-cover absolute inset-0 h-full w-full object-cover transition-transform duration-[400ms] group-hover:scale-[1.04]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        transition:name={`cover-${post.id}`}
      />
      <span class="absolute left-3 top-3 rounded-full bg-amber px-2.5 py-1 text-xs font-medium text-ink">
        {categoryLabel}
      </span>
    </div>
    <div class="px-1 pb-4">
      <h3 class="text-xl font-semibold tracking-[-0.02em] transition-colors duration-200 group-hover:text-accent">
        {post.title}
        <span
          class="inline-block -translate-x-1 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
          aria-hidden="true"
        >
          →
        </span>
      </h3>
      <p class="text-sm text-text-subtle mb-2 tabular-nums">
        {post.pubDate.toLocaleDateString('nl-NL')} · {readMinutes} min leestijd
      </p>
      {post.description && (
        <p class="text-text-subtle line-clamp-3">{post.description}</p>
      )}
    </div>
  </a>
</article>
