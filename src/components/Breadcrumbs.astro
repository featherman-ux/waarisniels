---
// Kruimelpad + bijbehorend BreadcrumbList-schema uit één bron, zodat wat Google
// leest en wat de bezoeker ziet niet uit elkaar kunnen lopen.
export interface Crumb {
  name: string;
  href: string;
}

export interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const siteUrl = (import.meta.env.SITE ?? Astro.url.origin).replace(/\/$/, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: `${siteUrl}${c.href}`,
  })),
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

<nav class="breadcrumbs" aria-label="Kruimelpad">
  {crumbs.map((crumb, i) =>
    i === crumbs.length - 1 ? (
      <span aria-current="page">{crumb.name}</span>
    ) : (
      <>
        <a href={crumb.href}>{crumb.name}</a>
        <span aria-hidden="true">/</span>
      </>
    )
  )}
</nav>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-subtle);
    margin-bottom: 1.25rem;
  }
  .breadcrumbs a {
    color: var(--text-subtle);
    text-decoration: none;
    /* "Home" was 39x22px — te klein om te raken. De regel zelf moet dun blijven,
       dus groeit alleen het onzichtbare tikvlak naar 44px hoog. */
    position: relative;
  }
  .breadcrumbs a::after {
    content: '';
    position: absolute;
    left: -0.2rem;
    right: -0.2rem;
    top: 50%;
    height: 44px;
    transform: translateY(-50%);
  }
  .breadcrumbs a:hover {
    color: var(--accent);
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--ink);
    max-width: 40ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Op een telefoon staat de posttitel al metershoog in de hero erboven; die
     eronder nog eens over twee regels herhalen is ruis. Het kruimelpad blijft
     compleet voor Google — dat leest het schema, niet deze weergave. */
  @media (max-width: 599px) {
    /* De laatste <span> is de titel zelf (aria-current), niet het scheidingsteken —
       daardoor matchte :last-of-type hier niets en bleef er een losse "/" hangen
       ("Home / Blog /"). Het laatste scheidingsteken is de één-na-laatste span. */
    .breadcrumbs [aria-current='page'],
    .breadcrumbs > span[aria-hidden='true']:nth-last-of-type(2) {
      display: none;
    }
  }
</style>
