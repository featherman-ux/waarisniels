---
export interface Props {
  text: string;
  href?: string;
  class?: string;
}

const { text, href, class: className = '' } = Astro.props;
---

{href ? (
  <a href={href} class={`chip ${className}`}>
    {text}
  </a>
) : (
  <span class={`chip ${className}`}>
    {text}
  </span>
)}

<style>
  .chip {
    display: inline-block;
    background: var(--paper-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-subtle);
    text-decoration: none;
    font-weight: 500;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Een chip is ~32px hoog; als link is dat te klein om betrouwbaar te raken (44px
     is de ondergrens van zowel Apple als Google). In een wolk van twintig chips
     zou 44px hoge pillen het beeld flink opblazen, dus groeit alleen het
     tikvlak: een onzichtbaar vlak van 44px, verticaal gecentreerd. De verticale
     tussenruimte in .chip-row is 8px, dus de vlakken van twee rijen raken elkaar
     net niet. Niet-klikbare chips (losse <span>) blijven zoals ze waren. */
  a.chip {
    position: relative;
  }
  a.chip::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 44px;
    transform: translateY(-50%);
  }
</style>