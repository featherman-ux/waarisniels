---
// Mini-kaart op de homepage: een voorvertoning van de route, volledig als inline
// SVG. Geen Leaflet, geen externe CDN, geen client-side JavaScript.
//
// Waarom niet meer met Leaflet: dit blok was altijd al een plaatje achter één
// grote link naar /map/ — je kon er niet in slepen of zoomen. Toch laadde het
// leaflet.js en leaflet.css van jsdelivr, wachtte het tot window.L bestond, en
// initialiseerde het een volledige kaart met tegels van Esri. Dat is veel
// beweegbare delen voor iets statisch, en precies daar ging het op de telefoon
// mis: op Niels' toestel bleef de kaart onzichtbaar, terwijl er in Chrome niets
// aan de hand leek.
//
// De route zelf komt voorgeprojecteerd uit src/data/route-preview.json (13KB,
// gegenereerd door scripts/build-route-preview.mjs uit public/data/route.geojson).
// Wijzigt de route, draai dan dat script opnieuw.
import preview from '../data/route-preview.json';

// Streeppatroon per vervoerswijze, gelijk aan /map: één accentkleur voor alles,
// het patroon doet het onderscheid.
const DASH: Record<string, string | undefined> = {
  bus: undefined,
  car: '7 4',
  motor: '2 7',
  flight: '6 6',
  boat: '1 6',
};
---

<div class="mini-map-wrap">
  <a class="mini-map-link" href="/map/">
    <span class="sr-only">Bekijk de interactieve kaart</span>

    <svg
      class="mini-map"
      viewBox={`0 0 ${preview.width} ${preview.height}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={`Route langs ${preview.dots.length} stops in Zuid-Amerika`}
    >
      {Object.entries(preview.paths).map(([mode, d]) => (
        <path
          d={d}
          fill="none"
          stroke="var(--accent)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-dasharray={DASH[mode]}
          opacity="0.9"
        />
      ))}

      {preview.dots.map((p) => (
        <circle cx={p.x} cy={p.y} r="3.6" fill="var(--accent)" stroke="var(--card)" stroke-width="1.6" />
      ))}
    </svg>
  </a>

  <span class="mini-map-cta" aria-hidden="true">Open kaart →</span>
</div>

<style>
  .mini-map-wrap {
    position: relative;
  }

  /* De link is het hele blok: zo is er maar één tikdoel en kan er niets
     overheen vallen. */
  .mini-map-link {
    display: block;
    position: relative;
    background: var(--paper-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
  }
  .mini-map-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .mini-map {
    display: block;
    width: 100%;
    height: 320px;
    padding: 0.75rem;
    box-sizing: border-box;
  }

  /* Puur decoratief: de hele kaart is al een link, dus dit is geen apart
     tikdoel meer — vandaar een <span> en aria-hidden. */
  .mini-map-cta {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 0.9rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .mini-map {
      height: 260px;
    }
  }
</style>
