<style>
  .mini-map-wrap {
    position: relative;
  }
  .mini-map {
    height: 320px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .mini-map-link {
    position: absolute;
    inset: 0;
    z-index: 20;
    text-indent: -9999px;
  }
  .mini-map-cta {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 25;
    /* Was 36px hoog; met flex + min-height precies op de 44px-ondergrens. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 9999px;
    padding: 0 1rem;
    font-size: .9rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
</style>

<div class="mini-map-wrap">
  <a class="mini-map-link" href="/map/">Bekijk interactieve kaart</a>
  <div id="mini-map" class="mini-map" role="img" aria-label="Mini kaart van mijn route"></div>
  <a href="/map/" class="mini-map-cta" aria-label="Bekijk de interactieve kaart">Open kaart →</a>
</div>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
/>
<script defer src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>

<script type="module" is:inline>
  // Zelfde valkuil als op /map: leaflet.js staat op defer, en bij een
  // view-transition-navigatie (of gewoon een trage mobiele verbinding) is
  // window.L er nog niet wanneer astro:page-load vuurt. De oude code stopte dan
  // en probeerde het nooit meer — de homepage toonde een leeg kaartvlak. Nu
  // wachten we tot Leaflet er is.
  function whenLeaflet(callback, tries) {
    tries = tries || 0;
    if (window.L) return callback();
    if (tries > 100) return console.warn("[MiniMap] Leaflet is niet geladen");
    setTimeout(function () { whenLeaflet(callback, tries + 1); }, 100);
  }

  document.addEventListener("astro:page-load", () => whenLeaflet(initMiniMap));

  async function initMiniMap() {
    const container = document.getElementById("mini-map");
    if (!container || container.dataset.ready) return;
    container.dataset.ready = "true";

    const map = L.map("mini-map", {
      scrollWheelZoom: false,
      dragging: true,
      zoomControl: false
    });

    // CARTO's gratis anonieme tegels zijn gestopt (tonen nu een "API key required"-
    // watermerk) — Esri's Gray Canvas basemaps zijn het dichtstbijzijnde monochrome
    // alternatief zonder account/key. Base + Reference (labels) als twee lagen,
    // zoals Esri's eigen Leaflet-voorbeelden dat opzetten.
    const isDark = document.documentElement.classList.contains('dark');
    const esriTheme = isDark ? 'Dark_Gray' : 'Light_Gray';
    const tileOpts = { maxZoom: 16, attribution: 'Tiles &copy; Esri' };
    L.tileLayer(`https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_${esriTheme}_Base/MapServer/tile/{z}/{y}/{x}`, tileOpts).addTo(map);
    L.tileLayer(`https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_${esriTheme}_Reference/MapServer/tile/{z}/{y}/{x}`, tileOpts).addTo(map);

    map.setView([-2.17, -79.922], 6);

    let bounds = null;
    const rootStyles = getComputedStyle(document.documentElement);
    const accent = rootStyles.getPropertyValue('--accent').trim();

    try {
      const res = await fetch('/data/route.geojson');
      const geo = await res.json();
      // Monochroom: één accentkleur voor de hele route, vervoerswijze via
      // streeppatroon i.p.v. een aparte kleur per modus.
      const layer = L.geoJSON(geo, {
        style: f => {
          const dashByMode = { bus: null, car: '8 4', motor: '2 8', flight: '6 6' };
          return { color: accent, weight: 3, opacity: 0.85, dashArray: dashByMode[f?.properties?.mode] ?? null };
        }
      }).addTo(map);
      bounds = layer.getBounds();
    } catch (e) {
      console.warn("[MiniMap] Kon route niet laden:", e);
    }

    try {
      const res = await fetch('/data/places.json');
      const places = await res.json();
      const markers = places
        .filter(p => typeof p.lat === "number" && typeof p.lon === "number")
        .map(p => {
          const m = L.circleMarker([p.lat, p.lon], { radius: 4, color: '#fff', weight: 1.5, fillColor: accent, fillOpacity: 1 }).addTo(map);
          m.bindTooltip(p.name || "Stop", { direction: "top", offset: [0, -6] });
          return m;
        });
      if (!bounds && markers.length) {
        bounds = L.featureGroup(markers).getBounds();
      }
    } catch (e) {
      console.warn("[MiniMap] Kon places niet laden:", e);
    }

    if (bounds && bounds.isValid()) {
      map.fitBounds(bounds.pad(0.25));
    }

    // Leaflet meet de container bij het aanmaken. Staat die op dat moment nog op
    // 0px (fonts/layout nog niet klaar op een telefoon), dan blijft de kaart een
    // grijs vlak tot er iets anders een resize triggert. Deze observer vertelt
    // Leaflet alsnog dat hij opnieuw moet meten.
    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(() => map.invalidateSize());
      ro.observe(container);
    }
  }
</script>
