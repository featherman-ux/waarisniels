---
// Aanmeldformulier voor een mailtje bij een nieuwe post.
// Werkt zonder JavaScript (gewone form-POST naar /api/subscribe); met JS blijf
// je op de pagina en verschijnt het antwoord eronder.
export interface Props {
  /** Compacte variant voor in de footer. */
  compact?: boolean;
  title?: string;
  blurb?: string;
}

const {
  compact = false,
  title = 'Mailtje bij een nieuwe post?',
  blurb = 'Geen nieuwsbrief, geen reclame — alleen een berichtje als er iets nieuws staat. Afmelden kan met één klik.',
} = Astro.props;

const source = Astro.url.pathname;
const formId = `subscribe-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['subscribe', compact && 'subscribe--compact']}>
  {!compact && <h2>{title}</h2>}
  {compact && <p class="subscribe-title">{title}</p>}
  <p class="subscribe-blurb">{blurb}</p>

  <form id={formId} class="subscribe-form" method="POST" action="/api/subscribe">
    <input type="hidden" name="source" value={source} />

    {/* Honeypot: onzichtbaar voor mensen, onweerstaanbaar voor bots. */}
    <div class="hp" aria-hidden="true">
      <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <label class="sr-only" for={`${formId}-email`}>E-mailadres</label>
    <input
      id={`${formId}-email`}
      type="email"
      name="email"
      required
      placeholder="jouw@mail.nl"
      autocomplete="email"
    />
    <button type="submit">Aanmelden</button>
  </form>

  <p class="subscribe-status" role="status" aria-live="polite"></p>
</section>

<style>
  .subscribe {
    background: var(--paper-alt);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    max-width: 42rem;
    margin-inline: auto;
  }
  .subscribe h2 {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .subscribe-title {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }
  .subscribe-blurb {
    color: var(--text-subtle);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .subscribe--compact {
    background: transparent;
    padding: 0;
    margin: 0;
    max-width: none;
  }
  .subscribe--compact .subscribe-blurb {
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .subscribe-form input[type='email'] {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.7rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--card);
    color: var(--ink);
    font-size: 0.95rem;
  }
  .subscribe-form input[type='email']:focus-visible,
  .subscribe-form button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .subscribe-form button {
    padding: 0.7rem 1.4rem;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    min-height: 44px;
  }
  .subscribe-form button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .subscribe-status {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    color: var(--text-subtle);
    min-height: 1.2em;
  }
  .subscribe-status[data-state='error'] {
    color: var(--danger);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Één handler voor alle formulieren op de pagina (footer + inline), via
  // delegatie op document — dan overleeft het ook view-transition-navigaties.
  function initSubscribeForms() {
    document.querySelectorAll<HTMLFormElement>('.subscribe-form').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.parentElement?.querySelector<HTMLElement>('.subscribe-status');
        const button = form.querySelector('button');

        if (button) button.disabled = true;
        if (status) {
          status.dataset.state = '';
          status.textContent = 'Bezig…';
        }

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form) as any)),
          });
          const data = await res.json().catch(() => ({}));

          if (status) {
            if (res.ok) {
              status.dataset.state = 'ok';
              status.textContent = data.message ?? 'Check je mail.';
              form.reset();
            } else {
              status.dataset.state = 'error';
              status.textContent = data.error ?? 'Er ging iets mis.';
            }
          }
        } catch {
          if (status) {
            status.dataset.state = 'error';
            status.textContent = 'Geen verbinding. Probeer het zo nog eens.';
          }
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initSubscribeForms);
</script>
