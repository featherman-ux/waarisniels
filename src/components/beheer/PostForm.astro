---
import type { Post, Category } from '../../lib/db';
import { mediaUrl } from '../../lib/media';

export interface Props {
  post?: Post | null;
  categories: Category[];
}

const { post = null, categories } = Astro.props;

const toDateInput = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');

const fields = {
  id: post?.id ?? '',
  title: post?.title ?? '',
  slug: post?.slug ?? '',
  category: post?.category ?? categories[0]?.slug ?? 'reis',
  description: post?.description ?? '',
  body: post?.body ?? '',
  pubDate: toDateInput(post?.pubDate) || toDateInput(new Date()),
  tags: (post?.tags ?? []).join(', '),
  draft: post?.draft ?? true,
  locLat: post?.location?.lat ?? '',
  locLon: post?.location?.lon ?? '',
  locName: post?.location?.name ?? '',
  coverKey: post?.cover?.key ?? '',
  coverAlt: post?.cover?.alt ?? '',
  placeFact: post?.placeFact ?? '',
};
const coverPreview = fields.coverKey ? mediaUrl(fields.coverKey) : null;
---

<form id="post-form" class="space-y-6 max-w-3xl">
  <input type="hidden" name="id" value={fields.id} />

  <div>
    <label class="block text-sm font-medium mb-1" for="title">Titel *</label>
    <input id="title" name="title" required value={fields.title}
      class="w-full rounded border px-3 py-2 dark:bg-gray-800" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1" for="slug">Slug (leeg = automatisch)</label>
      <input id="slug" name="slug" value={fields.slug}
        class="w-full rounded border px-3 py-2 dark:bg-gray-800" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="category">Categorie</label>
      <select id="category" name="category" class="w-full rounded border px-3 py-2 dark:bg-gray-800">
        {categories.map((c) => (
          <option value={c.slug} selected={c.slug === fields.category}>{c.label}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1" for="pubDate">Publicatiedatum *</label>
      <input id="pubDate" name="pubDate" type="date" required value={fields.pubDate}
        class="w-full rounded border px-3 py-2 dark:bg-gray-800" />
    </div>
    <div class="flex items-end">
      <label class="inline-flex items-center gap-2">
        <input id="draft" name="draft" type="checkbox" checked={fields.draft} />
        <span>Concept (nog niet live)</span>
      </label>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1" for="description">Korte omschrijving</label>
    <textarea id="description" name="description" rows="2"
      class="w-full rounded border px-3 py-2 dark:bg-gray-800">{fields.description}</textarea>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1" for="tags">Tags (komma-gescheiden)</label>
    <input id="tags" name="tags" value={fields.tags}
      class="w-full rounded border px-3 py-2 dark:bg-gray-800" />
  </div>

  <fieldset class="border rounded p-4">
    <legend class="text-sm font-medium px-1">Cover-afbeelding</legend>
    <div class="flex items-start gap-4">
      <div id="cover-preview-wrap" class:list={[coverPreview ? '' : 'hidden']}>
        <img id="cover-preview" src={coverPreview ?? ''} alt="" class="w-32 h-32 object-cover rounded" />
      </div>
      <div class="flex-1 space-y-2">
        <input id="cover-file" type="file" accept="image/*" />
        <input type="hidden" id="cover-key" name="coverKey" value={fields.coverKey} />
        <div class="flex gap-2">
          <input id="cover-alt" name="coverAlt" placeholder="Alt-tekst voor de cover" value={fields.coverAlt}
            class="flex-1 rounded border px-3 py-2 dark:bg-gray-800" />
          <button type="button" id="cover-alt-btn" class="text-sm underline whitespace-nowrap">
            ✨ Alt-tekst
          </button>
        </div>
        <p id="cover-status" class="text-sm text-gray-500"></p>
      </div>
    </div>
  </fieldset>

  <fieldset class="border rounded p-4">
    <legend class="text-sm font-medium px-1">Locatie (optioneel, voor de kaart)</legend>
    <p class="text-sm text-gray-500 mb-2">
      Wordt automatisch ingevuld uit de GPS-gegevens van een geüploade foto. Geen GPS
      gevonden? Tik op de kaart, of versleep de marker om 'm te corrigeren.
    </p>
    <div id="loc-map" class="rounded mb-3" style="height: 220px;"></div>
    <p id="loc-status" class="text-sm text-gray-500 mb-2"></p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <input name="locName" placeholder="Plaatsnaam" value={fields.locName}
        class="rounded border px-3 py-2 dark:bg-gray-800" />
      <input id="loc-lat" name="locLat" type="number" step="any" placeholder="Breedtegraad" value={fields.locLat}
        class="rounded border px-3 py-2 dark:bg-gray-800" />
      <input id="loc-lon" name="locLon" type="number" step="any" placeholder="Lengtegraad" value={fields.locLon}
        class="rounded border px-3 py-2 dark:bg-gray-800" />
    </div>
  </fieldset>

  <div>
    <div class="flex items-center justify-between mb-1">
      <label class="block text-sm font-medium" for="body">Inhoud (markdown, HTML mag) *</label>
      <div class="flex items-center gap-2">
        <label class="text-sm underline cursor-pointer">
          + Foto's in tekst
          <input id="inline-photo" type="file" accept="image/*" multiple class="hidden" />
        </label>
        <label class="text-sm underline cursor-pointer">
          + Video in tekst (max 50MB)
          <input id="inline-video" type="file" accept="video/*" class="hidden" />
        </label>
      </div>
    </div>
    <textarea id="body" name="body" required rows="18"
      class="w-full rounded border px-3 py-2 font-mono text-sm dark:bg-gray-800">{fields.body}</textarea>
    <p id="inline-status" class="text-sm text-gray-500 mt-1"></p>
    <div id="inline-photos-list" class="text-sm text-gray-500 mt-1 space-y-1"></div>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1" for="placeFact">Plek-weetje (optioneel)</label>
    <textarea id="placeFact" name="placeFact" rows="2"
      class="w-full rounded border px-3 py-2 dark:bg-gray-800">{fields.placeFact}</textarea>
  </div>

  <p id="form-error" class="text-red-600 hidden"></p>

  <div class="flex items-center gap-3">
    <button type="submit" class="rounded bg-gray-900 text-white px-4 py-2 font-semibold hover:opacity-90 dark:bg-gray-100 dark:text-gray-900">
      Opslaan
    </button>
    <a href="/beheer/" class="text-sm underline">Annuleren</a>
    {post && (
      <button type="button" id="delete-btn" class="ml-auto text-sm text-red-600 underline">
        Post verwijderen
      </button>
    )}
  </div>
</form>

<script>
  import { gps } from 'exifr';

  const form = document.getElementById('post-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error')!;

  async function upload(file: File | Blob, filename: string): Promise<{ key: string; url: string }> {
    const fd = new FormData();
    fd.append('file', file, filename);
    let res: Response;
    try {
      res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
    } catch (err: any) {
      throw new Error(`Netwerkfout tijdens upload: ${err?.message ?? err}`);
    }
    let data: { key?: string; url?: string; error?: string };
    try {
      data = await res.json();
    } catch {
      throw new Error(`Onverwacht antwoord van de server (status ${res.status})`);
    }
    if (!res.ok || !data.key || !data.url) {
      throw new Error(data.error || `Upload mislukt (status ${res.status})`);
    }
    return data as { key: string; url: string };
  }

  // --- Locatie: kaartje + sleepbare marker, gevoed door EXIF-GPS of een tik/sleep ---
  const locMapEl = document.getElementById('loc-map');
  const locLatInput = document.getElementById('loc-lat') as HTMLInputElement;
  const locLonInput = document.getElementById('loc-lon') as HTMLInputElement;
  const locStatus = document.getElementById('loc-status')!;

  let leafletMap: any;
  let marker: any;

  function setMarker(lat: number, lon: number, zoom = 12) {
    locLatInput.value = lat.toFixed(6);
    locLonInput.value = lon.toFixed(6);
    if (!leafletMap) return;
    if (marker) {
      marker.setLatLng([lat, lon]);
    } else {
      // @ts-ignore — Leaflet komt van het CDN-script, geen npm-import
      marker = L.marker([lat, lon], { draggable: true }).addTo(leafletMap);
      marker.on('dragend', () => {
        const pos = marker.getLatLng();
        locLatInput.value = pos.lat.toFixed(6);
        locLonInput.value = pos.lng.toFixed(6);
      });
    }
    leafletMap.setView([lat, lon], Math.max(leafletMap.getZoom(), zoom));
  }

  function initLocationMap() {
    // @ts-ignore
    if (typeof L === 'undefined' || !locMapEl) return;
    const startLat = parseFloat(locLatInput.value) || -2.17;
    const startLon = parseFloat(locLonInput.value) || -79.92;
    // @ts-ignore
    leafletMap = L.map(locMapEl, { scrollWheelZoom: false }).setView(
      [startLat, startLon],
      locLatInput.value ? 12 : 3
    );
    // @ts-ignore
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
    }).addTo(leafletMap);

    if (locLatInput.value && locLonInput.value) {
      setMarker(parseFloat(locLatInput.value), parseFloat(locLonInput.value));
    }

    leafletMap.on('click', (e: any) => setMarker(e.latlng.lat, e.latlng.lng));
  }

  document.addEventListener('DOMContentLoaded', initLocationMap);

  function withTimeout<T>(promise: Promise<T>, ms: number, fallback: T): Promise<T> {
    return new Promise((resolve) => {
      const timer = setTimeout(() => resolve(fallback), ms);
      promise.then(
        (v) => {
          clearTimeout(timer);
          resolve(v);
        },
        () => {
          clearTimeout(timer);
          resolve(fallback);
        }
      );
    });
  }

  async function tryAutoLocation(file: File) {
    if (locLatInput.value && locLonInput.value) return; // niet overschrijven als er al iets staat
    try {
      const coords = await withTimeout(gps(file), 5000, undefined);
      if (coords?.latitude && coords?.longitude) {
        setMarker(coords.latitude, coords.longitude);
        locStatus.textContent = 'Locatie automatisch herkend uit de foto — klopt het niet, versleep de marker.';
      }
    } catch (err) {
      // Geen GPS-EXIF (of geen EXIF-ondersteuning voor dit bestandstype) — geen probleem,
      // het kaartje blijft gewoon leeg/tik-baar.
      console.warn('[beheer] EXIF-GPS uitlezen mislukt/overgeslagen', err);
    }
  }

  // Sommige (vooral oudere/afwijkende) WebKit-builds herkennen de
  // imageOrientation-optie niet en gooien daar een DOMException op — probeer
  // dan gewoon zonder, dat verliest alleen de EXIF-rotatiecorrectie.
  async function decodeImage(file: File): Promise<ImageBitmap> {
    try {
      return await createImageBitmap(file, { imageOrientation: 'from-image' });
    } catch (err) {
      console.warn('[beheer] createImageBitmap met imageOrientation mislukt, probeer zonder', err);
      return await createImageBitmap(file);
    }
  }

  // --- Compressie: resize naar max 1600px + WebP kwaliteit 0.72, vóór upload (na de EXIF-read hierboven,
  // want canvas-encoding strípt EXIF — dat is hier ook precies goed voor privacy).
  // Harde timeout: als comprimeren te lang duurt (traag toestel/grote foto), upload
  // gewoon het origineel in plaats van de gebruiker eindeloos te laten wachten. ---
  async function compressImageInner(file: File, maxDim: number, quality: number): Promise<File> {
    const bitmap = await decodeImage(file);
    let { width, height } = bitmap;
    if (width > maxDim || height > maxDim) {
      const scale = maxDim / Math.max(width, height);
      width = Math.round(width * scale);
      height = Math.round(height * scale);
    }
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return file;
    ctx.drawImage(bitmap, 0, 0, width, height);
    const blob: Blob | null = await new Promise((resolve) =>
      canvas.toBlob(resolve, 'image/webp', quality)
    );
    if (!blob) return file;
    const webpName = file.name.replace(/\.[a-zA-Z0-9]+$/, '') + '.webp';
    return new File([blob], webpName, { type: 'image/webp' });
  }

  async function compressImage(file: File, maxDim = 1600, quality = 0.72): Promise<File> {
    try {
      return await withTimeout(compressImageInner(file, maxDim, quality), 15000, file);
    } catch (err) {
      // Comprimeren mislukt (bv. bestandstype dat de browser niet kan decoderen) —
      // upload dan gewoon het origineel, beter dan helemaal niets.
      console.warn('[beheer] compressImage mislukt, origineel wordt geüpload', err);
      return file;
    }
  }

  // --- Alt-tekst-knopje: op aanvraag, per foto (niet automatisch voor de hele batch) ---
  async function generateAltText(key: string): Promise<string> {
    const res = await fetch('/api/admin/alt-text', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key }),
    });
    const data = (await res.json()) as { alt?: string; error?: string };
    if (!res.ok || !data.alt) throw new Error(data.error || 'Alt-tekst genereren mislukt');
    return data.alt;
  }

  const coverFile = document.getElementById('cover-file') as HTMLInputElement;
  const coverKeyInput = document.getElementById('cover-key') as HTMLInputElement;
  const coverPreviewWrap = document.getElementById('cover-preview-wrap')!;
  const coverPreviewImg = document.getElementById('cover-preview') as HTMLImageElement;
  const coverStatus = document.getElementById('cover-status')!;
  const coverAltInput = document.getElementById('cover-alt') as HTMLInputElement;
  const coverAltBtn = document.getElementById('cover-alt-btn') as HTMLButtonElement;

  coverFile?.addEventListener('change', async () => {
    const file = coverFile.files?.[0];
    if (!file) return;
    coverStatus.textContent = 'Locatie checken...';
    await tryAutoLocation(file);
    coverStatus.textContent = 'Comprimeren en uploaden...';
    try {
      const compressed = await compressImage(file);
      const { key, url } = await upload(compressed, compressed.name);
      coverKeyInput.value = key;
      coverPreviewImg.src = url;
      coverPreviewWrap.classList.remove('hidden');
      coverStatus.textContent = 'Geupload.';
    } catch (err: any) {
      coverStatus.textContent = err.message ?? 'Upload mislukt';
    }
  });

  coverAltBtn?.addEventListener('click', async () => {
    if (!coverKeyInput.value) {
      coverStatus.textContent = 'Upload eerst een cover-foto.';
      return;
    }
    coverAltBtn.disabled = true;
    coverStatus.textContent = 'Alt-tekst genereren...';
    try {
      coverAltInput.value = await generateAltText(coverKeyInput.value);
      coverStatus.textContent = 'Alt-tekst ingevuld — overschrijfbaar.';
    } catch (err: any) {
      coverStatus.textContent = err.message ?? 'Alt-tekst genereren mislukt';
    } finally {
      coverAltBtn.disabled = false;
    }
  });

  const bodyEl = document.getElementById('body') as HTMLTextAreaElement;
  const inlineStatus = document.getElementById('inline-status')!;

  function insertAtCursor(text: string) {
    const start = bodyEl.selectionStart ?? bodyEl.value.length;
    const end = bodyEl.selectionEnd ?? bodyEl.value.length;
    bodyEl.value = bodyEl.value.slice(0, start) + text + bodyEl.value.slice(end);
    bodyEl.focus();
    bodyEl.selectionStart = bodyEl.selectionEnd = start + text.length;
  }

  const inlinePhotosList = document.getElementById('inline-photos-list')!;

  function addAltTextRow(key: string, url: string, label: string) {
    const row = document.createElement('p');
    row.textContent = `${label}: `;
    const altBtn = document.createElement('button');
    altBtn.type = 'button';
    altBtn.className = 'underline';
    altBtn.textContent = '✨ Alt-tekst';
    altBtn.addEventListener('click', async () => {
      altBtn.disabled = true;
      const prevLabel = altBtn.textContent;
      altBtn.textContent = 'Genereren...';
      try {
        const alt = await generateAltText(key);
        // De src is uniek (uuid-key), dus deze vervanging raakt alleen déze foto.
        bodyEl.value = bodyEl.value.replace(
          `src="${url}" alt=""`,
          `src="${url}" alt="${alt.replace(/"/g, '&quot;')}"`
        );
        row.append(` "${alt}" ingevuld — overschrijfbaar in de tekst.`);
        altBtn.remove();
      } catch (err: any) {
        altBtn.disabled = false;
        altBtn.textContent = prevLabel;
        row.append(` ${err.message ?? 'Alt-tekst genereren mislukt'}`);
      }
    });
    row.appendChild(altBtn);
    inlinePhotosList.appendChild(row);
  }

  document.getElementById('inline-photo')?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const files = Array.from(input.files ?? []);
    if (!files.length) return;

    const failed: string[] = [];
    // Eén voor één, niet parallel — anders lopen upload + Workers AI (EXIF/compressie
    // draait lokaal, maar de upload zelf gaat via de mobiele verbinding) elkaar op 4G
    // voor de voeten en wordt de voortgangsmelding onleesbaar.
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      const progress = files.length > 1 ? `Foto ${i + 1}/${files.length}: ` : '';
      inlineStatus.textContent = `${progress}locatie checken...`;
      await tryAutoLocation(file);
      inlineStatus.textContent = `${progress}comprimeren en uploaden...`;
      try {
        const compressed = await compressImage(file);
        const { key, url } = await upload(compressed, compressed.name);
        insertAtCursor(`\n<img src="${url}" alt="" />\n`);
        addAltTextRow(key, url, file.name);
      } catch (err: any) {
        failed.push(`${file.name} (${err.message ?? 'onbekende fout'})`);
      }
    }

    input.value = ''; // zelfde bestand nogmaals kunnen kiezen
    inlineStatus.textContent = failed.length
      ? `${files.length - failed.length}/${files.length} foto's toegevoegd. Mislukt: ${failed.join(', ')}`
      : `${files.length} foto${files.length > 1 ? "'s" : ''} toegevoegd — vul de alt-tekst in de tekst zelf aan, of gebruik de knop hieronder.`;
  });

  document.getElementById('inline-video')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    inlineStatus.textContent = 'Video uploaden (kan even duren)...';
    try {
      const { url } = await upload(file, file.name);
      insertAtCursor(`\n<video controls poster="">\n  <source src="${url}" type="${file.type}" />\n</video>\n`);
      inlineStatus.textContent = 'Video toegevoegd.';
    } catch (err: any) {
      inlineStatus.textContent = err.message ?? 'Upload mislukt';
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    const fd = new FormData(form);

    const lat = fd.get('locLat');
    const lon = fd.get('locLon');
    const name = fd.get('locName');
    const location =
      lat && lon
        ? { lat: Number(lat), lon: Number(lon), name: (name as string) || null }
        : null;

    const coverKey = (fd.get('coverKey') as string) || '';
    const cover = coverKey ? { key: coverKey, alt: (fd.get('coverAlt') as string) || '' } : null;

    const payload = {
      id: (fd.get('id') as string) || undefined,
      title: fd.get('title') as string,
      slug: (fd.get('slug') as string) || undefined,
      category: fd.get('category') as string,
      description: (fd.get('description') as string) || undefined,
      body: fd.get('body') as string,
      pubDate: fd.get('pubDate') as string,
      tags: (fd.get('tags') as string)
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean),
      draft: fd.get('draft') === 'on',
      location,
      cover,
      placeFact: (fd.get('placeFact') as string) || undefined,
    };

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Opslaan...';
    }

    try {
      let res: Response;
      try {
        res = await fetch('/api/admin/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      } catch (err: any) {
        throw new Error(`Netwerkfout: ${err?.message ?? err}`);
      }

      let data: { error?: string };
      try {
        data = await res.json();
      } catch {
        throw new Error(`Onverwacht antwoord van de server (status ${res.status})`);
      }

      if (!res.ok) {
        throw new Error(data.error || `Opslaan mislukt (status ${res.status})`);
      }
      window.location.href = '/beheer/';
    } catch (err: any) {
      errorEl.textContent = err.message ?? 'Opslaan mislukt';
      errorEl.classList.remove('hidden');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Opslaan';
      }
    }
  });

  document.getElementById('delete-btn')?.addEventListener('click', async () => {
    const id = (document.querySelector('input[name="id"]') as HTMLInputElement).value;
    if (!id) return;
    if (!confirm('Deze post definitief verwijderen?')) return;
    const res = await fetch(`/api/admin/posts?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    if (res.ok) {
      window.location.href = '/beheer/';
    } else {
      alert('Verwijderen mislukt');
    }
  });
</script>
