---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SubscribeForm from '../components/SubscribeForm.astro';

export interface Props {
  title: string;
  description?: string;
  /** Site-relatieve of absolute URL van de deelafbeelding (og:image). */
  image?: string;
  imageAlt?: string;
  /** 'article' op blogposts, 'website' op de rest. */
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  /** Zet noindex — voor /beheer en het analytics-dashboard. */
  noindex?: boolean;
}

const {
  title,
  description = 'WaarIsNiels – reisblog & kaart',
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

// Canonical: altijd dezelfde vorm (origin + pad + trailing slash, zonder query),
// zodat /blog/x, /blog/x/ en /blog/x?ref=whatsapp naar één URL wijzen.
const siteOrigin = (import.meta.env.SITE ?? Astro.url.origin).replace(/\/$/, '');
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = canonicalPath ? `${siteOrigin}${canonicalPath}/` : `${siteOrigin}/`;

// og:image moet absoluut zijn — WhatsApp, Slack en Facebook lossen een relatief
// pad niet op. Zonder eigen beeld valt alles terug op de homepagefoto.
const DEFAULT_OG_IMAGE = '/images/homepage.jpeg';
const rawImage = image ?? DEFAULT_OG_IMAGE;
const ogImage = /^https?:\/\//i.test(rawImage)
  ? rawImage
  : `${siteOrigin}${rawImage.startsWith('/') ? '' : '/'}${rawImage}`;
const ogImageAlt = imageAlt ?? title;

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/');
const isHomepage = path === '/';

const navLinks = [
  { href: '/blog/', match: '/blog', label: 'Blog' },
  { href: '/map/', match: '/map', label: 'Kaart' },
  { href: '/about/', match: '/about', label: 'Over' },
];

const navClasses = (match: string) => [
  'nav-link text-sm sm:text-base px-2 py-1 rounded transition-colors',
  isActive(match) ? 'text-accent' : 'text-text-subtle hover:text-accent'
];

const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="nl" class="scroll-smooth" >
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {/* Homepage heet gewoon "WaarIsNiels" i.p.v. "Waar is Niels? | WaarIsNiels". */}
    <title>{isHomepage ? 'WaarIsNiels – reisblog & kaart' : `${title} | WaarIsNiels`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={`${title} | WaarIsNiels`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="WaarIsNiels" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === 'article' && <meta property="article:author" content="Niels Veerman" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | WaarIsNiels`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="WaarIsNiels – nieuwe posts"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <ClientRouter />

    <script is:inline>
      // Zet .dark vóór de eerste paint (localStorage > OS-voorkeur), zodat er geen
      // witte flits is bij een donkere voorkeur. Enige plek die dit bepaalt — zie
      // DESIGN_HANDOFF.md §3.3. <html> persisteert over view-transition-navigaties
      // heen, dus dit hoeft maar één keer per echte paginalading te draaien.
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="bg-paper text-text antialiased">
    <header
      id="site-header"
      class:list={[
        'site-header sticky top-0 z-50',
        isHomepage ? 'header-transparent' : 'bg-card border-b border-line',
      ]}
    >
      <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="brand flex items-center gap-2 text-2xl font-display font-bold text-ink">
          <svg width="20" height="20" viewBox="0 0 100 100" aria-hidden="true" class="shrink-0">
            <path d="M50 10 28 50 50 90Z" fill="currentColor" />
            <path d="M50 10 72 50 50 90Z" fill="var(--accent)" />
          </svg>
          WaarIsNiels?
        </a>

        <div class="flex items-center gap-3 sm:gap-5">
          {navLinks.map(({ href, match, label }) => (
            <a
              href={href}
              aria-current={isActive(match) ? 'page' : undefined}
              class:list={navClasses(match)}
            >
              {label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main class="container mx-auto px-6 py-8 max-w-[1152px]">
      <slot />
    </main>

    <style>
      /* TRANSFORMATIE_PLAN.md §5.4: bij scroll van transparant naar een vervaagde,
         verzadigde glasachtige balk met haarlijn — de "premium" nav-overgang. */
      .site-header {
        transition: background-color var(--dur-move) var(--ease), backdrop-filter var(--dur-move) var(--ease), border-color var(--dur-move) var(--ease);
      }
      .site-header.bg-card {
        backdrop-filter: blur(20px) saturate(180%);
      }

      /* Transparant over de hero op de homepage, solide zodra er voorbij gescrold is
         (zie het script hieronder — luistert naar #hero-sentinel). Alle andere
         pagina's krijgen meteen de vaste variant. */
      .header-transparent {
        background: transparent;
        border-bottom: 1px solid transparent;
      }
      /* .brand krijgt zijn kleur via een custom property i.p.v. rechtstreekse
         .header-transparent(.header-solid) .brand-overrides: Vite's CSS-minifier
         (esbuild) bleek de .header-transparent-ancestor van .brand tijdens het
         minifyen te laten vallen zodra diezelfde eindselector in twee losse regels
         voorkwam (bij .nav-link gebeurde dat niet) — .brand stond zo permanent op
         var(--ink), ook met wit tekst nodig over de hero-foto. Eén regel voor .brand
         i.p.v. twee ontwijkt dat triggerpatroon volledig. */
      .header-transparent {
        --brand-color: #fff;
      }
      .brand {
        color: var(--brand-color, var(--ink));
      }
      .header-transparent .nav-link {
        color: #fff;
      }
      .header-transparent .nav-link[aria-current='page'] {
        color: #fff;
      }
      .header-transparent.header-solid {
        --brand-color: var(--ink);
        background: color-mix(in srgb, var(--card) 82%, transparent);
        backdrop-filter: blur(20px) saturate(180%);
        border-bottom-color: var(--line);
      }
      .header-transparent.header-solid .nav-link {
        color: var(--text-subtle);
      }
      .header-transparent.header-solid .nav-link[aria-current='page'] {
        color: var(--accent);
      }

      /* Animerende underline i.p.v. platte kleurverandering: groeit vanaf links bij
         hover, staat permanent aan op de actieve pagina. Amber blijft het actieve
         signaal (zelfde rol als de locatiedot elders), accent is het hover-signaal. */
      .nav-link {
        position: relative;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        left: 0.5rem;
        right: 0.5rem;
        bottom: -2px;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--dur-move) var(--ease);
      }
      .nav-link:hover::after {
        transform: scaleX(1);
      }
      .nav-link[aria-current='page']::after {
        background: var(--amber);
        transform: scaleX(1);
      }
      .header-transparent .nav-link::after {
        background: rgba(255, 255, 255, 0.9);
      }
      .header-transparent .nav-link[aria-current='page']::after {
        background: var(--amber);
      }
    </style>

    <!-- Header-transparantie draait via astro:page-load i.p.v. DOMContentLoaded: met
         <ClientRouter /> aan wisselt de pagina-inhoud client-side, dus dit moet na élke
         navigatie opnieuw een observer aan de (mogelijk nieuwe) #hero-sentinel hangen. -->
    <script is:inline>
      document.addEventListener('astro:page-load', function () {
        var header = document.getElementById('site-header');
        var sentinel = document.getElementById('hero-sentinel');
        if (!header) return;
        if (!sentinel || typeof IntersectionObserver === 'undefined') {
          header.classList.remove('header-solid');
          return;
        }
        var observer = new IntersectionObserver(
          function (entries) {
            // isIntersecting alleen is niet genoeg: de sentinel is óók "niet zichtbaar"
            // wanneer hij nog ónder de viewport hangt. De positie van zijn rand vertelt
            // aan welke kant hij eruit is gelopen.
            header.classList.toggle('header-solid', entries[0].boundingClientRect.top <= 64);
          },
          { threshold: [0, 1], rootMargin: '-64px 0px 0px 0px' }
        );
        observer.observe(sentinel);
      });
    </script>

    <footer class="site-footer">
      <div class="footer-subscribe">
        <SubscribeForm compact />
      </div>

      <div class="footer-inner">
        <div class="footer-brand">
          <p class="footer-wordmark">WaarIsNiels?</p>
          <p class="footer-blurb">
            Reisverhalen en een kaart met waar ik ben geweest. Geschreven door
            Niels Veerman.
          </p>
        </div>

        <nav class="footer-col" aria-label="Lezen">
          <h2>Lezen</h2>
          <a href="/blog/">Alle posts</a>
          <a href="/map/">Kaart</a>
          <a href="/rss.xml">RSS-feed</a>
        </nav>

        <nav class="footer-col" aria-label="Over">
          <h2>Over</h2>
          <a href="/about/">Over Niels</a>
          <a href="/colofon/">Colofon</a>
          <a href="mailto:veerman.niels@gmail.com">Mail</a>
          <a href="https://instagram.com/n.veerman" target="_blank" rel="noopener noreferrer">Instagram</a>
        </nav>
      </div>

      <div class="footer-bottom">
        <p>&copy; {currentYear} Niels Veerman</p>
        <p>
          Gebouwd met <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
          op Cloudflare — <a href="/colofon/">hoe precies</a>.
        </p>
      </div>
    </footer>

    <style>
      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: 5rem;
        padding: 3rem 1.5rem 2rem;
      }
      .footer-subscribe {
        max-width: 1152px;
        margin: 0 auto 3rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--line);
      }
      .footer-inner {
        max-width: 1152px;
        margin-inline: auto;
        display: grid;
        gap: 2.5rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 640px) {
        .footer-inner {
          grid-template-columns: 2fr 1fr 1fr;
          gap: 3rem;
        }
      }
      .footer-wordmark {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--ink);
        margin-bottom: 0.5rem;
      }
      .footer-blurb {
        color: var(--text-subtle);
        max-width: 34ch;
        line-height: 1.6;
      }
      .footer-col h2 {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-subtle);
        margin-bottom: 0.75rem;
      }
      .footer-col a {
        display: block;
        color: var(--ink);
        text-decoration: none;
        padding: 0.3rem 0;
        font-size: 0.95rem;
      }
      .footer-col a:hover {
        color: var(--accent);
      }
      .footer-bottom {
        max-width: 1152px;
        margin: 2.5rem auto 0;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-subtle);
      }
      .footer-bottom a {
        color: var(--text-subtle);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .footer-bottom a:hover {
        color: var(--accent);
      }
    </style>

    <!-- Lightbox voor .photo-grid-foto's (zie global.css .lightbox*). Volledig via
         event-delegatie op document — geen page-load-herinitialisatie nodig, want elke
         handler zoekt zijn elementen pas op het moment van de interactie zelf op. Dat
         maakt 'm vanzelf bestand tegen view-transition-navigaties. -->
    <dialog id="lightbox" class="lightbox">
      <button type="button" id="lightbox-close" aria-label="Sluiten" class="lightbox-close">✕</button>
      <button type="button" id="lightbox-prev" aria-label="Vorige foto" class="lightbox-nav lightbox-prev">‹</button>
      <img id="lightbox-img" alt="" />
      <button type="button" id="lightbox-next" aria-label="Volgende foto" class="lightbox-nav lightbox-next">›</button>
    </dialog>

    <script is:inline>
      (function () {
        var gallery = [];
        var index = 0;

        function show() {
          var imgEl = document.getElementById('lightbox-img');
          var el = gallery[index];
          if (!imgEl || !el) return;
          imgEl.src = el.currentSrc || el.src;
          imgEl.alt = el.alt || '';
        }
        function open(images, i) {
          var dialog = document.getElementById('lightbox');
          if (!dialog) return;
          gallery = images;
          index = i;
          show();
          dialog.showModal();
          document.body.style.overflow = 'hidden';
        }
        function close() {
          var dialog = document.getElementById('lightbox');
          if (dialog) dialog.close();
          document.body.style.overflow = '';
        }
        function next() { index = (index + 1) % gallery.length; show(); }
        function prev() { index = (index - 1 + gallery.length) % gallery.length; show(); }

        document.addEventListener('click', function (e) {
          var img = e.target.closest && e.target.closest('.photo-grid img');
          if (img) {
            var grid = img.closest('.photo-grid');
            var images = Array.prototype.slice.call(grid.querySelectorAll('img'));
            open(images, images.indexOf(img));
            return;
          }
          var id = e.target && e.target.id;
          if (id === 'lightbox-close') close();
          else if (id === 'lightbox-next') next();
          else if (id === 'lightbox-prev') prev();
          else if (e.target && e.target.id === 'lightbox') close(); // klik op de backdrop
        });

        document.addEventListener('keydown', function (e) {
          var dialog = document.getElementById('lightbox');
          if (!dialog || !dialog.open) return;
          if (e.key === 'ArrowRight') next();
          if (e.key === 'ArrowLeft') prev();
        });

        // 'cancel' (Escape bij <dialog>) bubbelt niet — capture-phase nodig om 'm te vangen.
        document.addEventListener('cancel', function (e) {
          if (e.target && e.target.id === 'lightbox') {
            e.preventDefault();
            close();
          }
        }, true);

        var touchStartX = 0;
        document.addEventListener('touchstart', function (e) {
          if (e.target.closest && e.target.closest('#lightbox')) touchStartX = e.touches[0].clientX;
        }, { passive: true });
        document.addEventListener('touchend', function (e) {
          if (!(e.target.closest && e.target.closest('#lightbox'))) return;
          var dx = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) > 50) { dx > 0 ? prev() : next(); }
        }, { passive: true });
      })();
    </script>

    <!-- Beeld dat landt i.p.v. verschijnt (TRANSFORMATIE_PLAN.md §5.2): .loaded wordt
         gezet zodra een foto klaar is met laden, ook D1-postbody-content (.photo-grid)
         waar ik geen onload-attribuut op kan zetten. 'load' bubbelt niet — capture-phase
         nodig. Al-gecachte afbeeldingen (img.complete) krijgen 'm meteen bij page-load,
         anders zou het delegated-event nooit meer vuren voor die afbeelding. -->
    <script is:inline>
      document.addEventListener('astro:page-load', function () {
        document.querySelectorAll('img:not(.loaded)').forEach(function (img) {
          if (img.complete) img.classList.add('loaded');
        });
      });
      document.addEventListener('load', function (e) {
        if (e.target && e.target.tagName === 'IMG') e.target.classList.add('loaded');
      }, true);
    </script>

    <!-- data-astro-rerun: laat Astro dit script bij élke view-transition-navigatie
         opnieuw uitvoeren i.p.v. alleen bij de eerste paginalading — anders telt de
         analytics alleen de allereerste pagina van een bezoek. -->
    <script is:inline data-astro-rerun>
      (async () => {
        if (typeof window === 'undefined') return;
        try {
          await fetch('/api/analytics', {
            method: 'POST',
            headers: {'content-type': 'application/json'},
            body: JSON.stringify({
              type: 'pageview',
              path: location.pathname,
              ref: document.referrer || null,
              ua: navigator.userAgent.slice(0, 120),
              w: window.innerWidth,
              h: window.innerHeight,
            }),
            keepalive: true,
          });
        } catch {}
      })();
    </script>
  </body>
</html>
