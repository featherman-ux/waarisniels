---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'WaarIsNiels – reisblog & kaart' } = Astro.props;

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/');
const isHomepage = path === '/';

const navLinks = [
  { href: '/blog/', match: '/blog', label: 'Blog' },
  { href: '/map/', match: '/map', label: 'Kaart' },
  { href: '/about/', match: '/about', label: 'Over' },
];

const navClasses = (match: string) => [
  'nav-link text-sm sm:text-base px-2 py-1 rounded transition-colors',
  isActive(match)
    ? 'text-deep underline underline-offset-4 decoration-amber decoration-2'
    : 'text-text-subtle hover:text-deep'
];

const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="nl" class="scroll-smooth" >
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{`${title} | WaarIsNiels`}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={`${title} | WaarIsNiels`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | WaarIsNiels`} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />

    <script is:inline>
      // Zet .dark vóór de eerste paint (localStorage > OS-voorkeur), zodat er geen
      // witte flits is bij een donkere voorkeur. Enige plek die dit bepaalt — zie
      // DESIGN_HANDOFF.md §3.3: dit vervangt de oude @media(prefers-color-scheme)-aanpak.
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="bg-paper text-text antialiased">
    <header
      id="site-header"
      class:list={[
        'backdrop-blur sticky top-0 z-50 transition-colors duration-200',
        isHomepage ? 'header-transparent' : 'bg-card/90 border-b border-line',
      ]}
    >
      <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="brand text-2xl font-display font-bold text-ink">WaarIsNiels?</a>

        <div class="flex items-center gap-3 sm:gap-5">
          {navLinks.map(({ href, match, label }) => (
            <a
              href={href}
              aria-current={isActive(match) ? 'page' : undefined}
              class:list={navClasses(match)}
            >
              {label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main class="container mx-auto px-6 py-8 max-w-[1152px]">
      <slot />
    </main>

    <style>
      /* Transparant over de hero op de homepage, solide zodra er voorbij gescrold is
         (zie het script hieronder — luistert naar #hero-sentinel via IntersectionObserver,
         geen scroll-listener). Alle andere pagina's krijgen meteen de vaste variant. */
      .header-transparent {
        background: transparent;
        border-bottom: 1px solid transparent;
      }
      .header-transparent .brand,
      .header-transparent .nav-link {
        color: #fff;
      }
      .header-transparent .nav-link[aria-current='page'] {
        color: #fff;
      }
      .header-transparent.header-solid {
        background: color-mix(in srgb, var(--card) 90%, transparent);
        border-bottom-color: var(--line);
      }
      .header-transparent.header-solid .brand {
        color: var(--ink);
      }
      .header-transparent.header-solid .nav-link {
        color: var(--text-subtle);
      }
      .header-transparent.header-solid .nav-link[aria-current='page'] {
        color: var(--deep);
      }
    </style>

    <script is:inline>
      // Header start transparant (over de hero), wordt solide zodra #hero-sentinel
      // (aan het eind van de hero, alleen op de homepage aanwezig) uit beeld scrolt.
      (function () {
        var header = document.getElementById('site-header');
        var sentinel = document.getElementById('hero-sentinel');
        if (!header || !sentinel || typeof IntersectionObserver === 'undefined') return;
        var observer = new IntersectionObserver(
          function (entries) {
            header.classList.toggle('header-solid', !entries[0].isIntersecting);
          },
          { rootMargin: '-64px 0px 0px 0px' }
        );
        observer.observe(sentinel);
      })();
    </script>

    <footer class="border-t border-line mt-16 py-10 text-center">
      <p class="text-text-subtle">&copy; {currentYear} WaarIsNiels.</p>
      <p class="text-sm text-text-subtle mt-1">Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-deep">Astro</a></p>
    </footer>

    <script is:inline>
      // Minimal anonymous pageview ping for analytics
      (async () => {
        if (typeof window === 'undefined') return;
        try {
          await fetch('/api/analytics', {
            method: 'POST',
            headers: {'content-type': 'application/json'},
            body: JSON.stringify({
              type: 'pageview',
              path: location.pathname,
              ref: document.referrer || null,
              ua: navigator.userAgent.slice(0, 120),
              w: window.innerWidth,
              h: window.innerHeight,
            }),
            keepalive: true,
          });
        } catch {}
      })();
    </script>
  </body>
</html>
