---
import type { Post } from '../lib/db';
import { getRelatedPosts } from '../lib/db';
import { renderMarkdown } from '../lib/markdown';
import { mediaUrl } from '../lib/media';
import BaseLayout from './BaseLayout.astro';
import { Comments, ViewCounter, LikeButton } from '../components/EnhancedComponents.jsx';
import Chip from '../components/Chip.astro';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post;

const db = Astro.locals.runtime.env.DB;
const contentHtml = renderMarkdown(post.body);
const heroSrc = mediaUrl(post.cover?.key);
const heroAlt = post.cover?.alt ?? title;

const dateStr = pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const currentPath = Astro.url.pathname;
const siteUrl = import.meta.env.SITE ?? Astro.url.origin ?? 'https://waarisniels.nl';

// --- Schema.org Structured Data ---
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? title,
  image: heroSrc,
  author: {
    '@type': 'Person',
    name: 'Niels Veerman',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Your Travel Blog',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', siteUrl).href,
    },
  },
  datePublished: pubDate.toISOString(),
  dateModified: post.updatedAt,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
};

const readNextPosts = await getRelatedPosts(db, post, 2);
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<BaseLayout title={title} description={description ?? title}>
  <article class="max-w-68ch mx-auto p-6 prose prose-lg dark:prose-invert">
    {heroSrc && (
      <figure class="hero rounded-lg overflow-hidden relative mb-6">
        <img
          src={heroSrc}
          alt={heroAlt}
          class="w-full h-auto object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="hero-grad absolute inset-0 bg-gradient-to-t from-black/60"></div>
      </figure>
    )}

    <header class="mb-6">
      <h1 class="font-display font-bold text-step-3 text-ink mb-2">{title}</h1>
      <p class="text-text-subtle mb-4">{dateStr}</p>
      {tags?.length && (
        <div class="flex flex-wrap gap-2 mb-6">
          {tags.map((t) => (
            <Chip text={t} />
          ))}
        </div>
      )}

      <div class="flex items-center gap-4 mb-4">
        <ViewCounter client:idle path={currentPath} apiUrl={siteUrl} />
        <LikeButton client:idle likeKey={currentPath} apiUrl={siteUrl} />
      </div>

      {description && <p class="text-lg text-text-subtle" style="text-wrap: pretty;">{description}</p>}
    </header>

    <section class="prose-wrap mb-12" set:html={contentHtml} />

    <footer>
      <Comments client:load slug={post.slug} apiUrl={siteUrl} />
    </footer>

    <!-- READ NEXT SECTION -->
    {readNextPosts.length > 0 && (
      <section class="read-next mt-16">
        <h2 class="text-2xl font-bold mb-6">Continue Reading</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {readNextPosts.map((rp) => (
            <a href={`/blog/${rp.slug}/`} class="post-card border rounded-lg overflow-hidden transition-all hover:shadow-lg">
              {mediaUrl(rp.cover?.key) && (
                <img
                  src={mediaUrl(rp.cover?.key)}
                  alt={rp.cover?.alt || ''}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="p-4">
                <h3 class="font-bold text-lg mb-2">{rp.title}</h3>
                <p class="text-text-subtle mb-3">{rp.description}</p>
                <span class="text-deep font-medium">Read Post →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* Add subtle improvements: larger headings, comfortable reading width */
  article.prose-wrap :global(p) {
    line-height: 1.7;
  }
  figure.hero-grad {
    pointer-events: none;
  }
</style>
