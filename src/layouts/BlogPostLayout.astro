---
import type { Post } from '../lib/db';
import { getRelatedPosts } from '../lib/db';
import { renderMarkdown } from '../lib/markdown';
import { mediaUrl, mediaSrcSet } from '../lib/media';
import BaseLayout from './BaseLayout.astro';
import { Comments, ViewCounter, LikeButton } from '../components/EnhancedComponents.jsx';
import Chip from '../components/Chip.astro';
import { tagHref } from '../lib/taxonomy';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post;

const db = Astro.locals.runtime.env.DB;
const contentHtml = renderMarkdown(post.body);
const coverKey = post.cover?.key;
const heroSrc = mediaUrl(coverKey, { width: 1600 }) ?? mediaUrl(coverKey);
const heroSrcSet = coverKey ? mediaSrcSet(coverKey, [640, 1200, 1920]) : undefined;
const heroAlt = post.cover?.alt ?? title;

const dateStr = pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const currentPath = Astro.url.pathname;
const siteUrl = import.meta.env.SITE ?? Astro.url.origin ?? 'https://waarisniels.nl';

const canonicalUrl = `${siteUrl.replace(/\/$/, '')}/blog/${post.slug}/`;

// Deelafbeelding: de cover op 1200px (og-formaat), absoluut gemaakt zodat
// WhatsApp/Slack/Facebook 'm kunnen ophalen.
const ogImage = mediaUrl(coverKey, { width: 1200 }) ?? undefined;

// --- Schema.org Structured Data ---
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? title,
  image: ogImage ?? heroSrc,
  inLanguage: 'nl-NL',
  keywords: tags?.length ? tags.join(', ') : undefined,
  author: {
    '@type': 'Person',
    name: 'Niels Veerman',
    url: `${siteUrl.replace(/\/$/, '')}/about/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'WaarIsNiels',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', siteUrl).href,
    },
  },
  datePublished: pubDate.toISOString(),
  dateModified: post.updatedAt,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: title, href: `/blog/${post.slug}/` },
];

const readNextPosts = await getRelatedPosts(db, post, 2);

// Publieke post: kort in de browser, langer op de Cloudflare-edge, en tijdens het
// verversen mag de oude versie nog even geserveerd worden. Zonder dit doet elke
// pageview een verse D1-query.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=300, stale-while-revalidate=86400'
);
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<BaseLayout
  title={title}
  description={description ?? title}
  image={ogImage}
  imageAlt={heroAlt}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={post.updatedAt}
>
  <div id="reading-progress" class="fixed top-0 left-0 w-full h-[2px] bg-amber z-[60] origin-left"></div>

  <article class="prose prose-lg dark:prose-invert max-w-none">
    {heroSrc && (
      <figure class="hero-figure full-bleed relative mb-8 -mt-8">
        <img
          src={heroSrc}
          srcset={heroSrcSet}
          sizes="100vw"
          alt={heroAlt}
          class="hero-img w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          transition:name={`cover-${post.id}`}
        />
        <div class="hero-grad absolute inset-0"></div>
        <div class="hero-title-overlay">
          <h1 class="hero-title font-display font-bold text-white mb-2">{title}</h1>
          <p class="text-white/85">{dateStr}</p>
        </div>
      </figure>
    )}

    <div class="reading-col">
      <Breadcrumbs crumbs={crumbs} />

      {!heroSrc && <h1 class="font-display font-bold text-step-3 text-ink mb-2">{title}</h1>}
      <header class="mb-6">
        {tags?.length && (
          <div class="flex flex-wrap gap-2 mb-6">
            {tags.map((t) => (
              <Chip text={t} href={tagHref(t)} />
            ))}
          </div>
        )}

        <div class="flex items-center gap-4 mb-4">
          <ViewCounter client:idle path={currentPath} apiUrl={siteUrl} />
          <LikeButton client:idle likeKey={currentPath} apiUrl={siteUrl} />
        </div>

        {description && <p class="text-lg text-text-subtle" style="text-wrap: pretty;">{description}</p>}
      </header>
    </div>

    <section class="prose-wrap prose-grid mb-12" set:html={contentHtml} />

    <div class="reading-col">
      {post.location && (
        <section class="location-outro rise mb-12">
          <p class="location-outro__place">
            <span class="location-dot" aria-hidden="true"></span>
            {post.location.name ?? 'Onbekende plek'}
          </p>
          {post.placeFact && <p class="location-outro__fact">&ldquo;{post.placeFact}&rdquo;</p>}
          <a href="/map/" class="location-outro__link">Bekijk op de kaart →</a>
        </section>
      )}

      {readNextPosts.length > 0 && (
        <section class="read-next rise mb-12">
          <h2 class="text-2xl font-bold mb-6">Lees ook</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {readNextPosts.map((rp) => (
              <a href={`/blog/${rp.slug}/`} class="post-card group border border-line rounded-lg overflow-hidden transition-colors duration-200 hover:border-accent">
                {rp.cover?.key && (
                  <div class="overflow-hidden">
                    <img
                      src={mediaUrl(rp.cover.key, { width: 480 })}
                      alt={rp.cover?.alt || ''}
                      class="w-full h-48 object-cover transition-transform duration-200 group-hover:scale-[1.03]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="p-4">
                  <h3 class="font-bold text-lg mb-2 transition-colors duration-200 group-hover:text-accent">{rp.title}</h3>
                  <p class="text-text-subtle mb-3">{rp.description}</p>
                  <span class="text-accent font-medium inline-flex items-center gap-1">
                    Lees verder
                    <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="mb-12">
        <SubscribeForm
          title="Volgende post ook lezen?"
          blurb="Laat je mailadres achter en je krijgt een berichtje zodra er een nieuwe post staat. Verder stuur ik je niks."
        />
      </section>

      <footer>
        <Comments client:load slug={post.slug} apiUrl={siteUrl} />
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .reading-col {
    max-width: 68ch;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  article.prose-wrap :global(p) {
    line-height: 1.7;
  }

  /* Breakout-grid: lopende tekst blijft op 68ch, .photo-grid/.video-responsive
     mogen breder — precies het tijdschrift-contrast uit DESIGN_HANDOFF §6.5. */
  .prose-grid {
    display: grid;
    grid-template-columns: 1fr min(68ch, 100% - 3rem) 1fr;
  }
  .prose-grid > :global(*) {
    grid-column: 2;
  }
  .prose-grid > :global(.photo-grid),
  .prose-grid > :global(.video-responsive) {
    grid-column: 1 / -1;
    width: min(100%, 1100px);
    justify-self: center;
  }

  .hero-figure {
    overflow: hidden;
  }
  /* Was min(70vh, 640px): op een telefoon vult dat vrijwel het hele scherm en moet
     je scrollen voor je bij de eerste zin bent. */
  .hero-img {
    height: min(52vh, 420px);
  }
  @media (min-width: 640px) {
    .hero-img {
      height: min(70vh, 640px);
    }
  }
  .hero-grad {
    /* Was 0.75 tot 45%: op mobiel staat de titel veel hoger in het beeld en liep
       hij over lichte delen van de foto — wit op wit. Sterker en hoger doorlopend. */
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.55) 35%,
      rgba(0, 0, 0, 0.2) 65%,
      transparent 90%
    );
    pointer-events: none;
  }

  /* --step-4 is de hero-schaal van de homepage (tot 6rem). Voor een posttitel van
     dertig tekens werd dat op een telefoon 50px, vier regels hoog, dwars over het
     onderwerp van de foto heen. Deze schaal loopt van 28px tot 64px. */
  .hero-title {
    font-size: clamp(1.75rem, 1.1rem + 3.2vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }
  .hero-title-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem 1.25rem 1.75rem;
    max-width: 68ch;
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .hero-title-overlay {
      padding: 3rem;
    }
  }

  .location-outro {
    background: var(--paper-alt);
    color: var(--ink);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .location-outro__place {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .location-outro__fact {
    font-style: italic;
    color: var(--text-subtle);
    max-width: 50ch;
    margin: 0 auto 1rem;
    text-wrap: pretty;
  }
  .location-outro__link {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Leesvoortgang: puur CSS, geen JS meer (TRANSFORMATIE_PLAN.md §5.4). In browsers
     zonder scroll()-ondersteuning blijft de balk gewoon op scaleX(0) staan — geen
     kapotte state, alleen geen animatie. */
  #reading-progress {
    transform: scaleX(0);
    animation: reading-progress linear;
    animation-timeline: scroll(root);
  }
  @keyframes reading-progress {
    to { transform: scaleX(1); }
  }
</style>
