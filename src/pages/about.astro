---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Over Niels";
const pageDescription = "Lees meer over mij en het verhaal achter Waar is Niels?";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <style>
    header.hero {
      background: var(--paper-alt);
      color: var(--ink);
      text-align: center;
      padding: clamp(3rem, 6vw, 5rem) 1.5rem;
      margin-bottom: clamp(2.5rem, 5vw, 4rem);
      border-radius: var(--radius-lg);
    }
    header.hero h1 {
      font-size: var(--step-3);
      letter-spacing: -0.03em;
      font-weight: 700;
      margin: 0 0 0.5rem;
    }
    header.hero p {
      font-size: 1.125rem;
      margin: 0;
      color: var(--text-subtle);
    }

    .about-grid {
      max-width: 900px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    @media (max-width: 640px) {
      .about-grid { grid-template-columns: 1fr; }
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 2rem;
      display: flex;
      flex-direction: column;
    }
    .card:first-child { grid-column: 1 / -1; }

    .card h2 {
      color: var(--ink);
      font-size: 1.5rem;
      letter-spacing: -0.025em;
      font-weight: 700;
      margin-top: 0;
      margin-bottom: 1rem;
    }
    .card p {
      line-height: 1.6;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .hero-img {
      width: 60%;
      max-width: 300px;
      border-radius: var(--radius-lg);
      margin: 1rem auto;
      display: block;
    }

    .btn-row {
      margin-top: auto;
    }
    .btn-row a {
      display: inline-block;
      background: var(--ink);
      color: var(--paper);
      padding: 0.6rem 1.1rem;
      margin: 0 0.5rem 0.5rem 0;
      border-radius: var(--radius-full);
      text-decoration: none;
      font-weight: 500;
      transition: opacity var(--dur-fast) var(--ease);
    }
    .btn-row a:hover {
      opacity: 0.85;
    }
  </style>

  <header class="hero">
    <h1>{pageTitle}</h1>
    <p>De perfecte pagina om mijn narcisme te voeden!</p>
  </header>

  <div class="about-grid">
    <article class="card">
      <h2>Wie ben ik?</h2>
      <p>Hi, ik ben Niels – data- en code enthousiasteling, reiziger en verhalenverteller. Deze site documenteert mijn avonturen in Zuid-Amerika en technologische projecten die ik achter de schermen bouw.</p>
      <p>Drie redenen voor deze site:</p>
      <ul>
        <li>Mijn reisupdates delen op mijn eigen, gepersonaliseerde platform.</li>
        <li>Een technisch visitekaartje creëren voor toekomstige sollicitaties in data & IT.</li>
        <li>Creatief bezig zijn tijdens regenachtige dagen.</li>
      </ul>
      <img src="/images/over.JPG" alt="Niels onderweg" class="hero-img" loading="lazy" />
      <div class="btn-row">
        <a href="/blog/">Laatste blogposts</a>
        <a href="/map/">Live kaart</a>
      </div>
    </article>

    <section class="card">
      <h2>Wat is Waar is Niels?</h2>
      <p>‘Waar is Niels?’ is mijn persoonlijke reisblog met een interactieve wereldkaart, AI-features en near real-time updates, speciaal voor vrienden, familie en stalkers.</p>
    </section>

    <section class="card">
      <h2>Contact</h2>
      <p>Website nodig? Stuur een mail! Of check veermandev.nl !!! (in aanbouw) & help me naar de 50.000 volgers! nog maar 1 of 2 te gaan!</p>
      <div class="btn-row">
        <a href="mailto:veerman.niels@gmail.com">Mail</a>
        <a href="https://instagram.com/n.veerman" target="_blank" rel="noopener">Instagram</a>
      </div>
    </section>
  </div>
</BaseLayout>
