---
import BaseLayout from '../layouts/BaseLayout.astro';
import JigsawPuzzle from '../components/JigsawPuzzle.astro';

const pageTitle = "Niels";
const pageDescription = "Oke, Oke, Oke, Oke, Oke, Oke";

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400'
);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <style>
    header.hero {
      background: var(--paper-alt);
      color: var(--ink);
      text-align: center;
      padding: clamp(3rem, 6vw, 5rem) 1.5rem;
      margin-bottom: clamp(2.5rem, 5vw, 4rem);
      border-radius: var(--radius-lg);
    }
    header.hero h1 {
      font-size: var(--step-3);
      letter-spacing: -0.03em;
      font-weight: 700;
      margin: 0 0 0.5rem;
    }
    header.hero p {
      font-size: 1.125rem;
      margin: 0;
      color: var(--text-subtle);
    }

    .about-grid {
      max-width: 900px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    @media (max-width: 640px) {
      .about-grid { grid-template-columns: 1fr; }
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 2rem;
      display: flex;
      flex-direction: column;
    }
    .card:first-child { grid-column: 1 / -1; }

    .card h2 {
      color: var(--ink);
      font-size: 1.5rem;
      letter-spacing: -0.025em;
      font-weight: 700;
      margin-top: 0;
      margin-bottom: 1rem;
    }
    .card p {
      line-height: 1.6;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .puzzle-intro {
      color: var(--text-subtle);
      margin-bottom: 1.25rem;
    }

    .btn-row {
      margin-top: auto;
    }
    .btn-row a {
      display: inline-block;
      background: var(--ink);
      color: var(--paper);
      padding: 0.6rem 1.1rem;
      margin: 0 0.5rem 0.5rem 0;
      border-radius: var(--radius-full);
      text-decoration: none;
      font-weight: 500;
      transition: opacity var(--dur-fast) var(--ease);
    }
    .btn-row a:hover {
      opacity: 0.85;
    }
  </style>

  <header class="hero">
    <h1>{pageTitle}</h1>
    <p></p>
  </header>

  <div class="about-grid">
    <article class="card">
      <h2>Leg mij bij elkaar</h2>
      <p class="puzzle-intro">Tik een stukje aan en daarna de plek waar het heen moet.</p>
      <JigsawPuzzle src="images/puzzel.jpg" alt="Niels onder de druivenrank" />
    </article>

    <section class="card">
      <h2>Wat is Waar is Niels?</h2>
      <p>‘Waar is Niels?’ is mijn persoonlijke reisblog met een interactieve wereldkaart, AI-features en near real-time updates, speciaal voor vrienden, familie en stalkers.</p>
    </section>

    <section class="card">
      <h2>Contact</h2>
      <p>Website nodig? Stuur een mail! Of check veermandev.nl !!! (in aanbouw) & help me naar de 50.000 volgers! nog maar 1 of 2 te gaan!</p>
      <div class="btn-row">
        <a href="mailto:veerman.niels@gmail.com">Mail</a>
        <a href="https://instagram.com/n.veerman" target="_blank" rel="noopener">Instagram</a>
      </div>
    </section>
  </div>
</BaseLayout>
