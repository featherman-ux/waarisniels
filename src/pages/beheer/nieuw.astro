---
import { requireAccess } from '../../pages/api/_utils';

// Zelfde reden als in de admin-API: Access dekt waarisniels.nl, niet de
// pages.dev-preview-URL's, en die praten met dezelfde productiedatabase.
const denied = requireAccess({ request: Astro.request, url: Astro.url });
if (denied) return denied;
// Beveiliging loopt via Cloudflare Access op het pad /beheer (zie
// docs/cloudflare-setup.md §5) — deze pagina doet zelf geen auth-check.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostForm from '../../components/beheer/PostForm.astro';
import { listCategories } from '../../lib/db';

const db = Astro.locals.runtime.env.DB;
const categories = await listCategories(db);
---
<link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script slot="head" src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
<BaseLayout title="Nieuwe post" description="Nieuwe blogpost">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Nieuwe post</h1>
    <PostForm categories={categories} />
  </div>
</BaseLayout>
