---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import { listPosts, getLatestLocatedPost } from '../lib/db';
import BlogPostPreview from '../components/BlogPostPreview.astro';
import HomePopup from '../components/HomePopup.astro';
import { VibeWidget } from '../components/VibeWidget.jsx';

const db = Astro.locals.runtime.env.DB;
const [latestPosts, latestLocated] = await Promise.all([
  listPosts(db, { limit: 3 }),
  getLatestLocatedPost(db),
]);
---

<BaseLayout title="Waar is Niels?" description="Welkom op mijn reisblog">
  <!-- Floating Vibe Widget -->
  <VibeWidget client:load />

  <!-- Homepage-hero: eigen klassenaam (home-hero), losstaand van het gedeelde
       .hero-figuur op postpagina's (die twee botsten eerder qua CSS). -->
  <section class="home-hero">
    <img
      src="/images/homepage.jpeg"
      alt="Nieuwe hero-afbeelding voor de homepage"
    />
    <div class="hero-text">
      <div>
        <h1>Waar is Niels?</h1>
        <p>Voorlopig geen updates meer vrees ik!</p>
      </div>
    </div>
  </section>

  <!-- Popup -->
  <HomePopup />

  <!-- Waar is Niels nu -->
  {latestLocated && (
    <section class="waar-is-niels-nu">
      <h2>Waar is Niels nu?</h2>
      <p class="location">
        {latestLocated.location?.name ?? 'Onderweg'}
        {' · '}
        {latestLocated.pubDate.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long' })}
      </p>
      {latestLocated.placeFact && <p class="fact">{latestLocated.placeFact}</p>}
      <a href={`/blog/${latestLocated.slug}/`}>Lees de laatste post →</a>
    </section>
  )}

  <!-- Map link -->
  <div class="map-link">
    <a href="/map">
      🗺️ Bekijk de kaart met mijn reisroute
    </a>
  </div>

  <!-- Latest blog posts -->
  <section class="posts">
    <h2>Laatste blogposts</h2>
    {latestPosts.length > 0 ? (
      <div class="grid-posts">
        {latestPosts.map(post => (<BlogPostPreview post={post} />))}
      </div>
    ) : (
      <p style="text-align:center;">Nog geen blogposts beschikbaar.</p>
    )}
  </section>

</BaseLayout>
