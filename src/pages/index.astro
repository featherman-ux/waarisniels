---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import { listPosts, getLatestDestination } from '../lib/db';
import { getCachedPlaceFact } from '../lib/place-fact';
import { mediaUrl, mediaSrcSet } from '../lib/media';
import BlogPostPreview from '../components/BlogPostPreview.astro';
import MiniMap from '../components/MiniMap.astro';

const { env, ctx } = Astro.locals.runtime;
const db = env.DB;

const [latestPosts, destination] = await Promise.all([
  listPosts(db, { limit: 3 }),
  getLatestDestination(db),
]);

// Funfact: eerst het weetje dat al bij de post is opgeslagen, anders één AI-call per
// plek die 30 dagen in KV blijft staan (zie src/lib/place-fact.ts).
const funFact = destination
  ? destination.post.placeFact || (await getCachedPlaceFact(env, destination.place, ctx))
  : '';

// Hero volgt de nieuwste post met een cover — homepage vernieuwt zichzelf bij elke
// post. Valt terug op de vaste foto als geen enkele van de laatste posts een cover heeft.
const heroPost = latestPosts.find((p) => p.cover?.key) ?? null;
const heroImgSrc = heroPost ? mediaUrl(heroPost.cover!.key, { width: 1920 }) : '/images/homepage.jpeg';
const heroImgSrcSet = heroPost ? mediaSrcSet(heroPost.cover!.key, [768, 1280, 1920]) : undefined;
const heroImgAlt = heroPost ? (heroPost.cover!.alt ?? heroPost.title) : 'Waar is Niels?';
const heroHref = heroPost ? `/blog/${heroPost.slug}/` : null;
---

<BaseLayout title="Waar is Niels?" description="Welkom op mijn reisblog">
  <div id="hero-sentinel" aria-hidden="true"></div>

  <section class="home-hero full-bleed">
    <img
      src={heroImgSrc}
      srcset={heroImgSrcSet}
      sizes="100vw"
      alt={heroImgAlt}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-text">
      <div>
        <h1>Waar is <span class="hero-accent">Niels</span>?</h1>
        <p>Voorlopig geen updates meer vrees ik!</p>
        {heroHref && (
          <a href={heroHref} class="hero-link">Bekijk de laatste post →</a>
        )}
      </div>
    </div>
  </section>

  {destination && (
    <section class="destination-fact rise">
      <p class="eyebrow">Funfact laatste bestemming</p>
      <p class="place">
        <span class="location-dot" aria-hidden="true"></span>
        {destination.place}
      </p>
      {funFact && <p class="fact">{funFact}</p>}
      <a href={`/blog/${destination.post.slug}/`}>Lees de laatste post →</a>
    </section>
  )}

  <section class="posts rise">
    <h2>Laatste blogposts</h2>
    {latestPosts.length > 0 ? (
      <div class="grid-posts">
        {latestPosts.map((post, i) => (<BlogPostPreview post={post} eager={i === 0} />))}
      </div>
    ) : (
      <p style="text-align:center;">Nog geen blogposts beschikbaar.</p>
    )}
  </section>

  <section class="map-section rise">
    <h2>De route tot nu toe</h2>
    <MiniMap />
  </section>
</BaseLayout>
