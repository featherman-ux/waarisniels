---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Kaart";
const pageDescription = "Eenvoudige, snelle kaart met mijn route en stops (bus, auto, motor, vlucht).";
---

<link
  slot="head"
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>
<script
  slot="head"
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  defer
></script>

<style>
  .hero {
    text-align: center;
    padding: 2rem 1rem 0.5rem;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }
  .hero p {
    color: var(--text-subtle);
  }
  .card {
    position: relative;
    overflow: hidden;
    margin: 0 auto 2rem;
  }
  .map-wrap {
    height: min(80vh, 760px);
    width: 100%;
  }
  .legend-panel {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 400; /* boven Leaflet's eigen panes (max ~650), onder de zoom-controls' klikbereik */
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    background: color-mix(in srgb, var(--card) 92%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    font-size: 0.85rem;
    max-width: calc(100% - 2rem);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    color: var(--text-subtle);
  }
  .legend-line {
    width: 20px;
    height: 0;
    border-top-width: 2.5px;
    border-top-style: solid;
    border-color: var(--accent);
  }
  .note {
    text-align: center;
    margin: 1rem 0;
    color: var(--text-subtle);
    font-size: .9rem;
  }
  .map-ai-panel {
    max-width: 720px;
    margin: 0 auto 3rem;
    background: var(--paper-alt);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .map-ai-panel h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .map-ai-panel p {
    margin: 0;
    color: var(--text-subtle);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .map-wrap { height: 400px; }
    .map-ai-panel { margin-bottom: 2rem; }
  }
</style>

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hero">
    <h1>{pageTitle}</h1>
    <p>Hopelijk nu sneller en vloeiender!</p>
  </section>

  <aside id="map-ai-panel" class="map-ai-panel" aria-live="polite">
    <h3>AI Reisbuddy</h3>
    <p id="map-ai-text">niels is in Cusco. Je bent op weg naar Cusco, de historische hoofdstad van de Inca's! Kijk uit het raam en geniet van de adembenemende uitzichten op de Andes. Wacht maar tot je de majestueuze Sacsayhuamán-fortress ziet liggen, een van de meest indrukwekkende overblijfselen van de Inca-keizerlijke tijd.</p>
  </aside>

  <article class="card full-bleed">
    <div id="map" class="map-wrap"></div>
    <div class="legend-panel">
      <div class="legend-item">
        <span class="legend-line"></span>Bus
      </div>
      <div class="legend-item">
        <span class="legend-line" style="border-style: dashed;"></span>Auto
      </div>
      <div class="legend-item">
        <span class="legend-line" style="border-style: dotted;"></span>Motor
      </div>
      <div class="legend-item">
        <span class="legend-line" style="border-style: dashed; border-top-width: 1.5px;"></span>Vlucht
      </div>
      <div class="legend-item">
        <span class="legend-line" style="width:0;"></span>Stops / steden
      </div>
    </div>
  </article>

  <p class="note">Kaartdata wordt lokaal gecachet voor vlottere navigatie.</p>
</BaseLayout>

<script is:inline defer>
  // astro:page-load i.p.v. DOMContentLoaded: met <ClientRouter /> (fase F) wisselt de
  // pagina-inhoud client-side, dus dit moet ook draaien als je via een link naar /map
  // navigeert i.p.v. een verse paginalading.
  document.addEventListener('astro:page-load', async () => {
    if (typeof L === 'undefined') return;

    const map = L.map('map', {
      scrollWheelZoom: true,
      zoomControl: true,
      inertia: true,
    }).setView([-0.18, -78.47], 6);

    // CARTO Positron (licht) / Dark Matter (donker) i.p.v. de standaard OSM-tegels —
    // die zijn druk en bont onder een gekleurde route, CARTO laat de route eruit springen.
    const isDark = document.documentElement.classList.contains('dark');
    const cartoTheme = isDark ? 'dark_all' : 'light_all';
    L.tileLayer(`https://{s}.basemaps.cartocdn.com/${cartoTheme}/{z}/{x}/{y}{r}.png`, {
      attribution: '© OpenStreetMap contributors © CARTO',
      maxZoom: 19,
      detectRetina: true,
    }).addTo(map);

    const [routeRes, placesRes, postsRes] = await Promise.all([
      fetch('/data/route.geojson'),
      fetch('/data/places.json'),
      fetch('/api/map-posts'),
    ]);
    const routeGeo = routeRes.ok ? await routeRes.json() : null;
    const places = placesRes.ok ? await placesRes.json() : [];
    const postsGeo = postsRes.ok ? await postsRes.json() : null;

    const rootStyles = getComputedStyle(document.documentElement);

    if (routeGeo) {
      // Monochroom: één accentkleur voor de hele route, vervoerswijze via
      // streeppatroon i.p.v. een aparte kleur per modus (TRANSFORMATIE_PLAN.md §3).
      const accent = rootStyles.getPropertyValue('--accent').trim();
      const dashByMode = { bus: null, car: '8 4', motor: '2 8', flight: '6 6' };

      L.geoJSON(routeGeo, {
        style: ({ properties }) => ({
          color: accent,
          weight: 4,
          dashArray: dashByMode[properties.mode] ?? undefined,
        }),
      }).addTo(map);
    }

    const currentPlace = places[places.length - 1];

    const defaultIcon = L.icon({
      iconUrl: '/images/marker-icon.png',
      iconRetinaUrl: '/images/marker-icon-2x.png',
      shadowUrl: '/images/marker-shadow.png',
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -28],
      shadowSize: [41, 41],
    });

    const currentIcon = L.icon({
      iconUrl: '/images/marker-icon-2x.png',
      iconRetinaUrl: '/images/marker-icon-2x.png',
      shadowUrl: '/images/marker-shadow.png',
      iconSize: [30, 50],
      iconAnchor: [15, 50],
      popupAnchor: [1, -32],
      shadowSize: [50, 50],
    });

    const markers = places.map((p, index) => {
      const mk = L.marker([p.lat, p.lon], {
        icon: index === places.length - 1 ? currentIcon : defaultIcon,
      }).addTo(map);
      mk.bindPopup(`<strong>${p.name}</strong>${p.notes ? '<br>' + p.notes : ''}`);
      return mk;
    });

    const group = L.featureGroup(markers);

    // Tweede laag: blogposts met een locatie, uit D1. Andere kleur dan de vaste
    // route-stops, klik linkt door naar de post.
    const postFeatures = postsGeo?.features ?? [];
    const postMarkers = postFeatures.map((f) => {
      const [lon, lat] = f.geometry.coordinates;
      const mk = L.circleMarker([lat, lon], {
        radius: 9,
        color: '#fff',
        weight: 2,
        fillColor: rootStyles.getPropertyValue('--amber').trim(),
        fillOpacity: 1,
      }).addTo(map);
      mk.bindPopup(
        `<strong>${f.properties.title}</strong><br><a href="/blog/${f.properties.slug}/">Lees de post →</a>`
      );
      return mk;
    });

    if (postMarkers.length) {
      group.addLayer(L.featureGroup(postMarkers));
    }
    if (group.getBounds().isValid()) {
      map.fitBounds(group.getBounds().pad(0.1));
    }

    const aiPanel = document.getElementById('map-ai-text');
    const defaultHighlight = "niels is in Cusco. Je bent op weg naar Cusco, de historische hoofdstad van de Inca's! Kijk uit het raam en geniet van de adembenemende uitzichten op de Andes. Wacht maar tot je de majestueuze Sacsayhuamán-fortress ziet liggen, een van de meest indrukwekkende overblijfselen van de Inca-keizerlijke tijd.";

    if (aiPanel) {
      aiPanel.textContent = defaultHighlight;
    }

    // Bij voorkeur het gecachete weetje van de nieuwste locatie-post (geen live
    // AI-call per paginabezoek meer). Alleen als er nog geen enkele locatie-post
    // is, terugvallen op de oude live /api/ai-place-aanroep voor de vaste route.
    const latestPostFact = postFeatures[postFeatures.length - 1]?.properties?.placeFact;
    if (latestPostFact && aiPanel) {
      aiPanel.textContent = latestPostFact;
    } else if (currentPlace && aiPanel) {
      try {
        const res = await fetch('/api/ai-place', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ place: currentPlace.name, notes: currentPlace.notes }),
        });
        const data = res.ok ? await res.json() : null;
        aiPanel.textContent = data?.highlight || defaultHighlight;
      } catch (error) {
        console.warn('AI highlight mislukt', error);
        aiPanel.textContent = defaultHighlight;
      }
    }
  });
</script>
