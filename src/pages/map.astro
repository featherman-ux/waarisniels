---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getPostsWithLocation, listPosts } from '../lib/db';
import { COUNTRIES, postMatchesCountry, placesInCountry } from '../lib/taxonomy';
import { buildJourneyFacts, getJourneySummary } from '../lib/journey';

// De kaart zelf is JavaScript en dus onzichtbaar voor crawlers en voor iedereen
// zonder JS. Deze lijst eronder is dezelfde data als HTML: elk land, welke stops
// erin liggen en welke posts erbij horen.
const { env, ctx } = Astro.locals.runtime;
const db = env.DB;
const locatedPosts = await getPostsWithLocation(db);

// Samenvatting van de hele reis i.p.v. een weetje over één plek. De feiten komen
// uit de posts; het model mag er alleen twee zinnen van maken (zie lib/journey.ts).
const journeyFacts = buildJourneyFacts(await listPosts(db, { limit: 200 }));
const journeySummary = await getJourneySummary(env, journeyFacts, ctx);

const perLand = COUNTRIES.map((country) => ({
  country,
  stops: placesInCountry(country.slug),
  posts: locatedPosts
    .filter((p) => postMatchesCountry(p.tags, country.slug))
    .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime()),
})).filter((entry) => entry.stops.length > 0 || entry.posts.length > 0);

const pageTitle = "Kaart";
const pageDescription = "Eenvoudige, snelle kaart met mijn route en stops (bus, auto, motor, vlucht).";

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400'
);
---

<link
  slot="head"
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"
/>
<script
  slot="head"
  src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"
  defer
></script>

<style>
  .hero {
    text-align: center;
    padding: 2rem 1rem 0.5rem;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
  }
  .hero p {
    color: var(--text-subtle);
  }
  .card {
    position: relative;
    overflow: hidden;
    margin: 0 auto 2rem;
  }
  .map-wrap {
    height: min(80vh, 760px);
    width: 100%;
  }
  .legend-panel {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 400; /* boven Leaflet's eigen panes (max ~650), onder de zoom-controls' klikbereik */
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    background: color-mix(in srgb, var(--card) 92%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    font-size: 0.85rem;
    max-width: calc(100% - 2rem);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    color: var(--text-subtle);
  }
  .legend-line {
    width: 20px;
    height: 0;
    border-top-width: 2.5px;
    border-top-style: solid;
    border-color: var(--accent);
  }
  .note {
    text-align: center;
    margin: 1rem 0;
    color: var(--text-subtle);
    font-size: .9rem;
  }
  .map-ai-panel {
    max-width: 720px;
    margin: 0 auto 3rem;
    background: var(--paper-alt);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .map-ai-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-subtle);
  }
  .map-ai-meta {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-subtle);
  }
  #map-ai-text {
    font-size: 1.05rem;
    color: var(--ink);
    text-wrap: pretty;
  }
  .map-ai-panel p {
    margin: 0;
    color: var(--text-subtle);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .map-wrap { height: 400px; }
    .map-ai-panel { margin-bottom: 2rem; }
  }

  .map-crumbs {
    max-width: 1152px;
    margin: 1rem auto 0;
    padding-inline: 1.5rem;
  }
  .route-index {
    max-width: 1152px;
    margin: 4rem auto 0;
    padding-inline: 1.5rem;
  }
  .route-index h2 {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .route-intro {
    color: var(--text-subtle);
    max-width: 60ch;
    margin-bottom: 2rem;
  }
  .route-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .route-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1040px) {
    .route-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .route-card {
    background: var(--paper-alt);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.35rem;
  }
  .route-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .route-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .route-card h3 a:hover {
    color: var(--accent);
  }
  .route-stops {
    font-size: 0.85rem;
    color: var(--text-subtle);
    line-height: 1.5;
    margin-bottom: 0.85rem;
  }
  .route-posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .route-posts a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .route-posts a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .route-meta {
    display: block;
    font-size: 0.8rem;
    color: var(--text-subtle);
  }
  .route-empty {
    font-size: 0.85rem;
    color: var(--text-subtle);
    font-style: italic;
  }

  /* Leaflet zet zijn popups buiten deze component in de DOM, dus :global. */
  :global(.map-pop) {
    max-width: 15rem;
  }
  :global(.map-pop-thumb) {
    width: 100%;
    height: 6.5rem;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-bottom: 0.5rem;
    display: block;
  }
  :global(.map-pop-place) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-subtle);
    margin: 0 0 0.25rem;
  }
  :global(.map-pop-title) {
    display: block;
    font-size: 0.95rem;
    line-height: 1.3;
    margin-bottom: 0.2rem;
  }
  :global(.map-pop-meta) {
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    color: var(--text-subtle);
  }
  :global(.map-pop-desc) {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  :global(.map-pop-link) {
    display: block;
    font-weight: 600;
  }
  :global(.map-pop-land) {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--text-subtle) !important;
  }
</style>

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="map-crumbs">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Kaart', href: '/map/' }]} />
  </div>

  <section class="hero">
    <h1>{pageTitle}</h1>
    <p>Hier ben ik allemaal geweest. Hopelijk is deze kaart ooit helemaal vol.</p>
  </section>

  <aside id="map-ai-panel" class="map-ai-panel">
    <p class="map-ai-eyebrow">
      <span class="location-dot" aria-hidden="true"></span>
      De reis tot nu toe
    </p>
    <p id="map-ai-text">{journeySummary}</p>
    <p class="map-ai-meta">
      {journeyFacts.countries.length} landen · {journeyFacts.postCount} posts · nu in {journeyFacts.currentLocation}
    </p>
  </aside>

  <article class="card full-bleed">
    <div id="map" class="map-wrap"></div>
    <div class="legend-panel">
      <div class="legend-item">
        <span class="legend-line"></span>Bus
      </div>
      <div class="legend-item">
        <span class="legend-line" style="border-style: dashed;"></span>Auto
      </div>
      <div class="legend-item">
        <span class="legend-line" style="border-style: dotted;"></span>Motor
      </div>
      <div class="legend-item">
        <span class="legend-line" style="border-style: dashed; border-top-width: 1.5px;"></span>Vlucht
      </div>
      <div class="legend-item">
        <span class="legend-line" style="width:0;"></span>Stops / steden
      </div>
    </div>
  </article>

  <p class="note">Kaartdata wordt lokaal gecachet voor vlottere navigatie.</p>

  <section class="route-index">
    <h2>De route per land</h2>
    <p class="route-intro">
      Dezelfde stops als op de kaart, maar dan als lijst — handig als je iets
      specifieks zoekt, en het werkt ook als de kaart niet laadt.
    </p>

    <div class="route-grid">
      {perLand.map((entry) => (
        <article class="route-card">
          <h3>
            <a href={`/blog/land/${entry.country.slug}/`}>{entry.country.name}</a>
          </h3>
          {entry.stops.length > 0 && (
            <p class="route-stops">{entry.stops.map((s) => s.name).join(' · ')}</p>
          )}
          {entry.posts.length > 0 ? (
            <ul class="route-posts">
              {entry.posts.map((post) => (
                <li>
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                  <span class="route-meta">
                    {post.location?.name ?? ''}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="route-empty">Nog geen post met een locatie hier.</p>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline defer>
  // astro:page-load i.p.v. DOMContentLoaded: met <ClientRouter /> (fase F) wisselt de
  // pagina-inhoud client-side, dus dit moet ook draaien als je via een link naar /map
  // navigeert i.p.v. een verse paginalading.
  // Leaflet staat op een <script defer>. Bij een view-transition-navigatie kan
  // astro:page-load vóór dat script vuren — dan bestond L nog niet en stopte deze
  // handler er definitief mee, met een lege kaart als resultaat. Op een trage
  // mobiele verbinding gebeurde dat vaker dan op wifi, vandaar "soms".
  function whenLeaflet(callback, tries) {
    tries = tries || 0;
    if (typeof L !== 'undefined') return callback();
    if (tries > 100) return console.warn('[map] Leaflet is niet geladen');
    setTimeout(function () { whenLeaflet(callback, tries + 1); }, 100);
  }

  document.addEventListener('astro:page-load', function () {
    whenLeaflet(initMap);
  });

  async function initMap() {
    const container = document.getElementById('map');
    // Zonder deze vlag gooit Leaflet "Map container is already initialized" zodra
    // je via de nav terugkomt op deze pagina.
    if (!container || container.dataset.ready) return;
    container.dataset.ready = 'true';

    const map = L.map('map', {
      scrollWheelZoom: true,
      zoomControl: true,
      inertia: true,
    }).setView([-0.18, -78.47], 6);

    // Esri Gray Canvas (licht/donker) i.p.v. de standaard OSM-tegels — die zijn druk
    // en bont onder een gekleurde route, dit monochrome basiskaartje laat de route
    // eruit springen. (CARTO's gratis anonieme tegels zijn gestopt — tonen nu een
    // "API key required"-watermerk — vandaar de overstap.) Base + Reference (labels)
    // als twee lagen, zoals Esri's eigen Leaflet-voorbeelden dat opzetten.
    const isDark = document.documentElement.classList.contains('dark');
    const esriTheme = isDark ? 'Dark_Gray' : 'Light_Gray';
    const tileOpts = { maxZoom: 16, attribution: 'Tiles &copy; Esri' };
    L.tileLayer(`https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_${esriTheme}_Base/MapServer/tile/{z}/{y}/{x}`, tileOpts).addTo(map);
    L.tileLayer(`https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_${esriTheme}_Reference/MapServer/tile/{z}/{y}/{x}`, tileOpts).addTo(map);

    const [routeRes, placesRes, postsRes] = await Promise.all([
      fetch('/data/route.geojson'),
      fetch('/data/places.json'),
      fetch('/api/map-posts'),
    ]);
    const routeGeo = routeRes.ok ? await routeRes.json() : null;
    const places = placesRes.ok ? await placesRes.json() : [];
    const postsGeo = postsRes.ok ? await postsRes.json() : null;

    const rootStyles = getComputedStyle(document.documentElement);

    if (routeGeo) {
      // Monochroom: één accentkleur voor de hele route, vervoerswijze via
      // streeppatroon i.p.v. een aparte kleur per modus (TRANSFORMATIE_PLAN.md §3).
      const accent = rootStyles.getPropertyValue('--accent').trim();
      const dashByMode = { bus: null, car: '8 4', motor: '2 8', flight: '6 6' };

      L.geoJSON(routeGeo, {
        style: ({ properties }) => ({
          color: accent,
          weight: 4,
          dashArray: dashByMode[properties.mode] ?? undefined,
        }),
      }).addTo(map);
    }

    const defaultIcon = L.icon({
      iconUrl: '/images/marker-icon.png',
      iconRetinaUrl: '/images/marker-icon-2x.png',
      shadowUrl: '/images/marker-shadow.png',
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -28],
      shadowSize: [41, 41],
    });

    const currentIcon = L.icon({
      iconUrl: '/images/marker-icon-2x.png',
      iconRetinaUrl: '/images/marker-icon-2x.png',
      shadowUrl: '/images/marker-shadow.png',
      iconSize: [30, 50],
      iconAnchor: [15, 50],
      popupAnchor: [1, -32],
      shadowSize: [50, 50],
    });

    const postFeaturesRaw = postsGeo?.features ?? [];

    const escapeHtml = (value) =>
      String(value ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
      );

    // Een route-stop is interessanter als er een post bij hoort. Match eerst op
    // naam, anders op afstand (~55 km per 0,5 graad) — de coordinaten van een post
    // liggen zelden exact op de stop.
    const postForPlace = (place) => {
      const byName = postFeaturesRaw.find(
        (f) => (f.properties.placeName ?? '').toLowerCase() === place.name.toLowerCase()
      );
      if (byName) return byName;
      return postFeaturesRaw.find((f) => {
        const [lon, lat] = f.geometry.coordinates;
        return Math.abs(lat - place.lat) < 0.5 && Math.abs(lon - place.lon) < 0.5;
      });
    };

    const postPopup = (props, { compact } = {}) => {
      const thumb = props.thumb
        ? `<img class="map-pop-thumb" src="${escapeHtml(props.thumb)}" alt="" loading="lazy" />`
        : '';
      const desc =
        !compact && props.description
          ? `<p class="map-pop-desc">${escapeHtml(props.description)}</p>`
          : '';
      const meta = [props.date, props.readMinutes ? `${props.readMinutes} min` : null]
        .filter(Boolean)
        .join(' · ');
      const land = props.country
        ? `<a class="map-pop-land" href="/blog/land/${escapeHtml(props.country.slug)}/">Alles uit ${escapeHtml(props.country.name)} →</a>`
        : '';
      return `<div class="map-pop">
        ${thumb}
        <strong class="map-pop-title">${escapeHtml(props.title)}</strong>
        <p class="map-pop-meta">${escapeHtml(meta)}</p>
        ${desc}
        <a class="map-pop-link" href="/blog/${escapeHtml(props.slug)}/">Lees de post →</a>
        ${land}
      </div>`;
    };

    const markers = places.map((p, index) => {
      const mk = L.marker([p.lat, p.lon], {
        icon: index === places.length - 1 ? currentIcon : defaultIcon,
      }).addTo(map);

      const match = postForPlace(p);
      if (match) {
        // Stop met post: de popup wordt de post, want dat is waar je heen wilt.
        mk.bindPopup(
          `<div class="map-pop"><p class="map-pop-place">${escapeHtml(p.name)}</p></div>` +
            postPopup(match.properties, { compact: true })
        );
      } else {
        mk.bindPopup(
          `<div class="map-pop"><strong class="map-pop-title">${escapeHtml(p.name)}</strong>` +
            (p.notes ? `<p class="map-pop-desc">${escapeHtml(p.notes)}</p>` : '') +
            '</div>'
        );
      }
      return mk;
    });

    const group = L.featureGroup(markers);

    // Tweede laag: blogposts met een locatie, uit D1. Andere kleur dan de vaste
    // route-stops, klik linkt door naar de post.
    const postFeatures = postFeaturesRaw;
    const postMarkers = postFeatures.map((f) => {
      const [lon, lat] = f.geometry.coordinates;
      const mk = L.circleMarker([lat, lon], {
        radius: 9,
        color: '#fff',
        weight: 2,
        fillColor: rootStyles.getPropertyValue('--amber').trim(),
        fillOpacity: 1,
      }).addTo(map);
      mk.bindPopup(postPopup(f.properties));
      return mk;
    });

    if (postMarkers.length) {
      group.addLayer(L.featureGroup(postMarkers));
    }
    if (group.getBounds().isValid()) {
      map.fitBounds(group.getBounds().pad(0.1));
    }

    // Zie MiniMap: staat de container bij het aanmaken nog op 0px, dan blijft de
    // kaart een grijs vlak tot er iets resizet. Dit dwingt een hermeting af.
    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(function () { map.invalidateSize(); });
      ro.observe(container);
    }
  }
</script>
