---
// Afmeldlink uit de mailfooter en uit de List-Unsubscribe-header. Afmelden mag
// nooit meer dan één klik kosten, dus geen bevestigingsstap.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { unsubscribeByToken } from '../../lib/subscribers';

const token = Astro.url.searchParams.get('token')?.trim() ?? '';
const db = Astro.locals.runtime.env.DB;

const subscriber = token ? await unsubscribeByToken(db, token) : null;
const ok = subscriber?.status === 'unsubscribed';

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout
  title={ok ? 'Afgemeld' : 'Link werkt niet'}
  description="Afmelden voor de postnotificaties van WaarIsNiels."
  noindex
>
  <section class="melding">
    {ok ? (
      <>
        <h1>Afgemeld</h1>
        <p>
          Je krijgt geen mail meer van me. Je adres blijft alleen bewaard om te
          onthouden dát je afgemeld bent.
        </p>
        <p class="acties">
          <a class="knop" href="/blog/">Naar de blog</a>
        </p>
      </>
    ) : (
      <>
        <h1>Deze link werkt niet</h1>
        <p>
          Mogelijk was je al afgemeld. Lukt het niet, stuur dan even een mail naar
          <a href="mailto:veerman.niels@gmail.com">veerman.niels@gmail.com</a> —
          dan haal ik je er handmatig af.
        </p>
        <p class="acties">
          <a class="knop" href="/blog/">Naar de blog</a>
        </p>
      </>
    )}
  </section>
</BaseLayout>

<style>
  .melding {
    max-width: 46ch;
    margin: 4rem auto;
    padding-inline: 1.5rem;
    text-align: center;
  }
  .melding h1 {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .melding p {
    color: var(--text-subtle);
    line-height: 1.7;
    margin-bottom: 1rem;
    text-wrap: pretty;
  }
  .melding a {
    color: var(--accent);
  }
  .acties {
    margin: 2rem 0 0;
  }
  .knop {
    display: inline-block;
    background: var(--ink);
    color: var(--paper) !important;
    text-decoration: none;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-full);
    font-weight: 600;
  }
</style>
